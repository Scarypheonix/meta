#!/usr/bin/env bash
# ./check — the single gate. Build + lint + full test suite.
#
# Nothing merges and no phase is declared complete unless this exits 0. It is the local
# stand-in for CI and it enforces the project's hard budgets:
#
#   - the full suite must stay under 5 minutes  (FAIL_SECONDS)
#   - peak RSS must stay under 3 GB             (FAIL_RSS_MIB)
#
# Usage:
#   ./check            run everything
#   ./check fmt        formatting only
#   ./check lint       go vet only
#   ./check build      compile only
#   ./check test       tests only
#
# Environment:
#   UPDATE_GOLDEN=1    rewrite golden files instead of failing on a mismatch
#
# Portability: this runs on macOS (the target machine) and Linux (the development
# container) with nothing but bash, awk and ps. It deliberately does not depend on GNU
# time, which macOS does not ship, or on python, which macOS no longer guarantees.

set -uo pipefail
cd "$(dirname "$0")"

FAIL_SECONDS=300
WARN_SECONDS=180
FAIL_RSS_MIB=3072

if [ -t 1 ]; then
  BOLD=$'\033[1m'; RED=$'\033[31m'; GREEN=$'\033[32m'; YELLOW=$'\033[33m'; DIM=$'\033[2m'; OFF=$'\033[0m'
else
  BOLD=""; RED=""; GREEN=""; YELLOW=""; DIM=""; OFF=""
fi

failures=0
peak_rss_mib=0

# tree_rss_mib PID — resident set size of PID and every descendant, in MiB.
# ps reports RSS in KiB on both macOS and Linux.
tree_rss_mib() {
  ps -eo pid=,ppid=,rss= 2>/dev/null | awk -v root="$1" '
    { pid[NR]=$1; ppid[NR]=$2; rss[NR]=$3; n=NR }
    END {
      want[root]=1
      # Repeat until the descendant set stops growing; process tables are small.
      changed=1
      while (changed) {
        changed=0
        for (i=1; i<=n; i++) if (!want[pid[i]] && want[ppid[i]]) { want[pid[i]]=1; changed=1 }
      }
      total=0
      for (i=1; i<=n; i++) if (want[pid[i]]) total += rss[i]
      printf "%d", total/1024
    }'
}

# run_stage NAME COMMAND... — run, time, and sample peak RSS of the process tree.
run_stage() {
  local name="$1"; shift
  printf '%s==>%s %s%s%s\n' "$DIM" "$OFF" "$BOLD" "$name" "$OFF"
  local start; start=$(date +%s)

  "$@" &
  local pid=$!
  local stage_peak=0
  while kill -0 "$pid" 2>/dev/null; do
    local mib; mib=$(tree_rss_mib "$pid")
    if [ -n "$mib" ] && [ "$mib" -gt "$stage_peak" ] 2>/dev/null; then stage_peak=$mib; fi
    sleep 0.2 2>/dev/null || sleep 1
  done
  wait "$pid"; local rc=$?

  [ "$stage_peak" -gt "$peak_rss_mib" ] && peak_rss_mib=$stage_peak
  local secs=$(( $(date +%s) - start ))

  if [ "$rc" -eq 0 ]; then
    printf '    %sok%s   %s (%ds, %d MiB)\n' "$GREEN" "$OFF" "$name" "$secs" "$stage_peak"
  else
    printf '    %sFAIL%s %s (exit %d, %ds)\n' "$RED" "$OFF" "$name" "$rc" "$secs"
    failures=$((failures + 1))
  fi
}

check_fmt() {
  printf '%s==>%s %sgofmt%s\n' "$DIM" "$OFF" "$BOLD" "$OFF"
  local unformatted
  unformatted=$(gofmt -l cmd internal tests 2>/dev/null)
  if [ -n "$unformatted" ]; then
    printf '    %sFAIL%s these files are not gofmt-clean:\n%s\n' "$RED" "$OFF" "$unformatted"
    printf '    run: gofmt -w cmd internal tests\n'
    failures=$((failures + 1))
  else
    printf '    %sok%s   gofmt\n' "$GREEN" "$OFF"
  fi
}

stage="${1:-all}"
total_start=$(date +%s)

case "$stage" in
  fmt)   check_fmt ;;
  lint)  run_stage "go vet"   go vet ./... ;;
  build) run_stage "go build" go build ./... ;;
  test)  run_stage "go test"  go test -count=1 -timeout "${FAIL_SECONDS}s" ./... ;;
  all)
    check_fmt
    run_stage "go vet"   go vet ./...
    run_stage "go build" go build ./...
    run_stage "go test"  go test -count=1 -timeout "${FAIL_SECONDS}s" ./...
    ;;
  *)
    printf 'usage: ./check [fmt|lint|build|test]\n' >&2
    exit 2
    ;;
esac

total_s=$(( $(date +%s) - total_start ))

printf '\n%s────────────────────────────────────────%s\n' "$DIM" "$OFF"
printf 'elapsed:  %ds (budget %ds)\n' "$total_s" "$FAIL_SECONDS"
printf 'peak rss: %d MiB (budget %d MiB)\n' "$peak_rss_mib" "$FAIL_RSS_MIB"

if [ "$total_s" -gt "$FAIL_SECONDS" ]; then
  printf '%sOVER BUDGET%s: the suite took %ds; the ceiling is %ds.\n' "$RED" "$OFF" "$total_s" "$FAIL_SECONDS"
  printf 'Per the project constraints: stop feature work and fix this before continuing.\n'
  failures=$((failures + 1))
elif [ "$total_s" -gt "$WARN_SECONDS" ]; then
  printf '%swarning%s: %ds of the %ds budget used.\n' "$YELLOW" "$OFF" "$total_s" "$FAIL_SECONDS"
fi

if [ "$peak_rss_mib" -gt "$FAIL_RSS_MIB" ]; then
  printf '%sOVER BUDGET%s: peak RSS %d MiB exceeds the %d MiB ceiling.\n' \
    "$RED" "$OFF" "$peak_rss_mib" "$FAIL_RSS_MIB"
  failures=$((failures + 1))
fi

if [ "$failures" -eq 0 ]; then
  printf '\n%sPASS%s\n' "$GREEN" "$OFF"
  exit 0
fi
printf '\n%sFAIL%s (%d stage(s))\n' "$RED" "$OFF" "$failures"
exit 1
