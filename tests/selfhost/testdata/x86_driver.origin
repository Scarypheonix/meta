// The x86 encoder differential's stage1 half: emit a table of instructions and print the
// bytes.
//
// An encoder is right when the bytes are right, so the oracle needs no invention at all:
// `tests/selfhost/x86_test.go` performs the same sequence with `internal/x86` and compares.
// The table is not a cross product for its own sake -- it covers every instruction at least
// twice, once with low registers and once with high ones (which is what decides the REX
// prefix), and then covers the operand shapes that are the real risk surface exhaustively:
// every memory base and displacement class, every condition, every immediate class, every
// shift count class, and both directions of a label reference.

use std::io;
use std::list;
use std::str;

use x86;

fn main() {
    let a = x86::new_asm(4194304);

    a.mov_rr(x86::RAX, x86::RCX);
    a.mov_rr(x86::R12, x86::R13);
    a.mov_rr(x86::RSP, x86::RBP);
