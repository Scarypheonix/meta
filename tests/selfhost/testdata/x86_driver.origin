    print_hex(a.code);
}

const HEX: String = "0123456789abcdef";

/// The bytes, thirty-two to a line, so that a divergence names a byte offset rather than
/// one enormous line.
fn print_hex(code: List[i64]) {
    let mut line = "";
    let mut i = 0;
    while i < code.len() {
        let b = code.at(i);
        line = "\(line)\(HEX.slice(b >> 4, (b >> 4) + 1))\(HEX.slice(b & 15, (b & 15) + 1))";
        i = i + 1;
        if i % 32 == 0 {
            io::println(line);
            line = "";
        }
    }
    if line != "" {
        io::println(line);
    }
}
