use std::io;
use std::list;

// Two lists that hold the same elements are equal, whatever room each has left: the
// capacity is not part of the value, which is why `Array` carries a length of its own
// rather than being exactly as long as it was allocated (spec/13-collections.md).
fn main() {
    let grown = list::new[i64]();
    let mut i = 0;
    while i < 5 {
        grown.push(i);
        i = i + 1;
    }

    let placed = list::new[i64]();
    placed.push(0);
    placed.push(1);
    placed.push(2);
    placed.push(3);
    placed.push(4);

    io::println((grown == placed).to_str());
    placed.push(5);
    io::println((grown == placed).to_str());
    grown.push(5);
    io::println((grown == placed).to_str());
}
