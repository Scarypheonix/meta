// A program written without semicolons, computing its answers twice.
//
// ADR-0040 is defined by rewriting a token stream, so what this case asserts is that the
// rewriting is *unobservable*: `terse` below is written with no semicolon anywhere the rule
// can supply one, `explicit` is the same program with every semicolon written out, and the
// two must agree on all three engines at every optimization level.
//
// The shapes worth pinning, rather than the feature in the abstract:
//
//   - a tail expression before `}`, which rule 3 must leave alone or the function starts
//     returning `()` instead of its declared type
//   - brace-bodied `match` arms with no comma, which rule 1 must leave alone or a semicolon
//     lands where only a comma is grammatical
//   - a multi-line call and a multi-line list literal, which rule 2 covers with and without
//     a trailing comma
//   - an expression wrapped with the operator trailing, the one form the rule requires
//   - `break`, `continue` and `return`, which end statements and so must trigger
//   - `?`, which Phase 15 added to the trigger set, in both the position where it ends a
//     statement and the position where rule 3 must still leave it as a block's value
use std::io
use std::list

struct Span { lo: i64, hi: i64 }

fn width(s: Span) -> i64 {
    s.hi - s.lo
}

fn clamp(n: i64, lo: i64, hi: i64) -> i64 {
    if n < lo {
        lo
    } else {
        if n > hi { hi } else { n }
    }
}

fn sign_word(n: i64) -> String {
    match n.cmp(0) {
        Less => { "below" }
        Equal => { "at" }
        Greater => { "above" }
    }
}

/// Sums the spans that are wide enough, stopping at the first negative width.
fn survey(spans: List[Span], floor: i64) -> i64 {
    let mut total = 0
    let it = spans.into_iter()
    while let Some(s) = it.next() {
        let w = width(s)
        if w < 0 {
            break
        }
        if w < floor {
            continue
        }
        total = total + w
    }
    total
}

fn terse() -> String {
    let spans = [
        Span { lo: 0, hi: 4 },
        Span { lo: 2, hi: 3 },
        Span { lo: 10, hi: 20 }
    ]
    let picked = survey(spans, 2)

    // A call split over lines: rule 2 means no insertion inside the parentheses.
    let bounded = clamp(
        picked,
        0,
        12
    )

    // An expression that wraps, with the operator trailing.
    let flag = picked > 0 &&
        bounded <= 12 &&
        width(spans.at(0)) == 4

    "terse picked=\(picked) bounded=\(bounded) flag=\(flag) \(sign_word(bounded - picked))"
}

fn explicit() -> String {
    let spans = list::new[Span]();
    spans.push(Span { lo: 0, hi: 4 });
    spans.push(Span { lo: 2, hi: 3 });
    spans.push(Span { lo: 10, hi: 20 });
    let picked = survey(spans, 2);
    let bounded = clamp(picked, 0, 12);
    let flag = picked > 0 && bounded <= 12 && width(spans.at(0)) == 4;
    // No semicolon: this is the block's value, which is the whole point of rule 3.
    "explicit picked=\(picked) bounded=\(bounded) flag=\(flag) \(sign_word(bounded - picked))"
}

fn main() {
    io::println(terse())
    io::println(explicit())

    // `return` ends a statement, so the line break after it terminates one.
    io::println("\(early(5))")
    io::println("\(early(0 - 5))")

    io::println("\(show(quarter_terse(20))) \(show(quarter_explicit(20)))")
    io::println("\(show(quarter_terse(6))) \(show(quarter_explicit(6)))")
}

fn early(n: i64) -> i64 {
    if n < 0 {
        return 0
    }
    n * 2
}

fn maybe_half(n: i64) -> Option[i64] {
    if n % 2 == 0 { Some(n / 2) } else { None }
}

// `?` ends a statement (Phase 15's amendment to ADR-0040), so neither `let` here needs a
// semicolon -- and the last line is still the block's value, because rule 3 suppresses
// insertion before `}` whatever the trigger was.
fn quarter_terse(n: i64) -> Option[i64] {
    let a = maybe_half(n)?
    let b = maybe_half(a)?
    Some(b)
}

fn quarter_explicit(n: i64) -> Option[i64] {
    let a = maybe_half(n)?;
    let b = maybe_half(a)?;
    Some(b)
}

fn show(o: Option[i64]) -> String {
    match o {
        Some(n) => "\(n)",
        None => "none",
    }
}
