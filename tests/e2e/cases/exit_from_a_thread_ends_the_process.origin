use std::io;
use std::thread;
use std::process;

// `process::exit` ends the process, not the thread that called it (spec/17-process.md):
// the joining thread never comes back, exactly as ADR-0026 has it for a panic.
//
// Only the spawned thread prints. Two threads printing either side of a `spawn` would be
// racing for the order, and a differential case that depends on which won is not a case.
fn main() {
    let h = thread::spawn(|| -> i64 {
        io::println("in the thread");
        process::exit(7);
        0
    });
    let v = h.join();
    io::println("not reached: \(v)");
}
