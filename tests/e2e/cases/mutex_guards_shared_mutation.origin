use std::io;
use std::thread;
use std::sync;

struct Counter { mut n: i64 }

fn main() {
    // `Counter` has a `mut` field, so it cannot cross a thread boundary on its own
    // (ADR-0014). A `Mutex` is what makes it shareable, and the total is the same
    // whatever order the threads interleave in -- which is what makes this a valid
    // differential case.
    let m = sync::mutex(Counter { n: 0 });

    let a = thread::spawn(|| -> i64 {
        let mut i = 0;
        while i < 500 {
            m.with(|c: Counter| -> i64 { c.n = c.n + 1; 0 });
            i = i + 1;
        }
        0
    });
    let b = thread::spawn(|| -> i64 {
        let mut i = 0;
        while i < 500 {
            m.with(|c: Counter| -> i64 { c.n = c.n + 1; 0 });
            i = i + 1;
        }
        0
    });

    let x = a.join();
    let y = b.join();
    io::println(m.with(|c: Counter| -> i64 { c.n }).to_str());
}
