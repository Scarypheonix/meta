use std::io;

// ADR-0027. `let out = Option::None;` used to generalize to `forall T. Option[T]`, which
// under monomorphization (ADR-0010) and exact per-instantiation layouts (ADR-0019) names
// no single runtime type: the object was built at a descriptor keyed on an unresolved
// variable and matched against the real `Option[i64]` one. The interpreter printed the
// right answer and the virtual machine trapped with `no match arm matched` -- a wrong
// answer, not a crash, and invisible to any engine whose values are uniform.

struct Node { value: i64, tail: Option[Node] }

fn build(n: i64) -> Option[Node] {
    let mut out = Option::None;
    let mut i = 0;
    while i < n {
        out = Option::Some(Node { value: i, tail: out });
        i = i + 1;
    }
    out
}

fn total(list: Option[Node]) -> i64 {
    let mut sum = 0;
    let mut cur = list;
    while true {
        match cur {
            Option::Some(nd) => { sum = sum + nd.value; cur = nd.tail; },
            Option::None => { return sum; },
        }
    }
    sum
}

fn empty() -> Option[i64] {
    // The minimal shape: a binding whose loop never runs, so the value stays the one
    // built at the binding rather than any later assignment.
    let out = Option::None;
    out
}

fn main() {
    io::println(total(build(0)).to_str());
    io::println(total(build(1)).to_str());
    io::println(total(build(200)).to_str());
    match empty() {
        Option::Some(v) => { io::println("some"); },
        Option::None => { io::println("none"); },
    }
}
