// EXPECT: accept
// spec: 17-process.md — `process::exit` has type `!`, so it stands where any type is wanted.

// `process::exit` returns `!` (spec/17-process.md), so it stands where any type is wanted
// and the checker knows the code after it is unreachable (spec/03-types.md).
use std::io;
use std::process;

fn pick(ok: bool) -> i64 {
    if ok {
        return 1;
    }
    process::exit(2)
}

fn main() {
    let n = pick(true);
    let s: String = if n == 1 { "one" } else { process::exit(3) };
    io::println(s);
}
