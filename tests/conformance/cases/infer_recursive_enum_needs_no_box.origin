// EXPECT: accept
// spec/03 and ADR-0008: aggregates are references, so direct recursion is finite.

enum List { Nil, Cons(i64, List) }

fn sum(l: List) -> i64 {
    match l {
        List::Nil => 0,
        List::Cons(head, tail) => head + sum(tail),
    }
}

fn main() {
    let x = sum(List::Cons(1, List::Nil));
}
