// EXPECT: accept
// spec/05: patterns nest arbitrarily.

enum Inner { Yes(i64), No }
enum Outer { Wrap(Inner), Empty }

fn f(o: Outer) -> i64 {
    match o {
        Outer::Wrap(Inner::Yes(n)) => n,
        Outer::Wrap(Inner::No) => 0,
        Outer::Empty => -1,
    }
}

fn main() { let x = f(Outer::Empty); }
