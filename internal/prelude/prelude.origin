// The Origin prelude, in scope in every module without a `use`.
//
// The types and traits here are written in Origin, not built into the compiler, so that
// the language's own vocabulary goes through the same lexer, parser, resolver and
// checker as user code.
//
// The traits declare their signatures; the impls for primitive types are provided by the
// compiler (see internal/check's builtin impl table) because they cannot be written in
// Origin until the standard library exists in Phase 7. `Hash` waits for `Hasher`, which
// waits for Phase 7 as well.

use std::thread;
use std::chan;
use std::sync;
use std::array;
use std::list;
use std::hash;
use std::str;
use std::fs;
use std::float;

pub enum Option[T] {
    None,
    Some(T),
}

pub enum Result[T, E] {
    Ok(T),
    Err(E),
}

impl[T] Option[T] {
    /// Whether there is a value.
    pub fn is_some(self) -> bool {
        match self {
            Option::Some(_) => true,
            Option::None => false,
        }
    }

    /// Whether there is not.
    pub fn is_none(self) -> bool {
        match self {
            Option::Some(_) => false,
            Option::None => true,
        }
    }

    /// The value, or `fallback` when there is none.
    pub fn unwrap_or(self, fallback: T) -> T {
        match self {
            Option::Some(v) => v,
            Option::None => fallback,
        }
    }

    /// The value, or what `fallback` computes when there is none. Use this rather than
    /// `unwrap_or` when producing the fallback costs something.
    pub fn unwrap_or_else(self, fallback: fn() -> T) -> T {
        match self {
            Option::Some(v) => v,
            Option::None => fallback(),
        }
    }

    /// The value. TRAPS with `msg` when there is none.
    ///
    /// This is the one place a program says "I know there is a value here"; the trap is
    /// what makes being wrong about that loud rather than silent (ADR-0007).
    pub fn expect(self, msg: String) -> T {
        match self {
            Option::Some(v) => v,
            Option::None => panic(msg),
        }
    }

    /// `f` applied to the value, if there is one.
    pub fn map[U](self, f: fn(T) -> U) -> Option[U] {
        match self {
            Option::Some(v) => Option::Some(f(v)),
            Option::None => Option::None,
        }
    }

    /// `f` applied to the value, when `f` itself may find nothing.
    pub fn and_then[U](self, f: fn(T) -> Option[U]) -> Option[U] {
        match self {
            Option::Some(v) => f(v),
            Option::None => Option::None,
        }
    }

    /// The value, if there is one and `keep` accepts it.
    pub fn filter(self, keep: fn(T) -> bool) -> Option[T] {
        match self {
            Option::Some(v) => {
                if keep(v) {
                    Option::Some(v)
                } else {
                    Option::None
                }
            }
            Option::None => Option::None,
        }
    }

    /// This `Option` as a `Result`, with `err` standing in for the absent value. The
    /// bridge between "there is nothing" and "here is why" (spec/09-errors.md).
    pub fn ok_or[E](self, err: E) -> Result[T, E] {
        match self {
            Option::Some(v) => Result::Ok(v),
            Option::None => Result::Err(err),
        }
    }
}

impl[T, E] Result[T, E] {
    /// Whether this is an `Ok`.
    pub fn is_ok(self) -> bool {
        match self {
            Result::Ok(_) => true,
            Result::Err(_) => false,
        }
    }

    /// Whether this is an `Err`.
    pub fn is_err(self) -> bool {
        match self {
            Result::Ok(_) => false,
            Result::Err(_) => true,
        }
    }

    /// The value, dropping the error.
    pub fn ok(self) -> Option[T] {
        match self {
            Result::Ok(v) => Option::Some(v),
            Result::Err(_) => Option::None,
        }
    }

    /// The error, dropping the value.
    pub fn err(self) -> Option[E] {
        match self {
            Result::Ok(_) => Option::None,
            Result::Err(e) => Option::Some(e),
        }
    }

    /// The value, or `fallback` when this is an `Err`.
    pub fn unwrap_or(self, fallback: T) -> T {
        match self {
            Result::Ok(v) => v,
            Result::Err(_) => fallback,
        }
    }

    /// The value. TRAPS with `msg` when this is an `Err`.
    pub fn expect(self, msg: String) -> T {
        match self {
            Result::Ok(v) => v,
            Result::Err(_) => panic(msg),
        }
    }

    /// `f` applied to the value, leaving an error alone.
    pub fn map[U](self, f: fn(T) -> U) -> Result[U, E] {
        match self {
            Result::Ok(v) => Result::Ok(f(v)),
            Result::Err(e) => Result::Err(e),
        }
    }

    /// `f` applied to the error, leaving a value alone.
    ///
    /// This is how a function converts one error type into its own, which is what `?`
    /// cannot do for itself in Origin 0.1: `read_to_string(p).map_err(Fault::Io)?` is the
    /// idiom the diagnostic for a mismatched error type points at (spec/09-errors.md).
    pub fn map_err[F](self, f: fn(E) -> F) -> Result[T, F] {
        match self {
            Result::Ok(v) => Result::Ok(v),
            Result::Err(e) => Result::Err(f(e)),
        }
    }

    /// `f` applied to the value, when `f` itself may fail the same way.
    pub fn and_then[U](self, f: fn(T) -> Result[U, E]) -> Result[U, E] {
        match self {
            Result::Ok(v) => f(v),
            Result::Err(e) => Result::Err(e),
        }
    }
}

pub enum Ordering {
    Less,
    Equal,
    Greater,
}

/// Total ordering. `<` and friends are built in for primitives; user types compare
/// through `cmp` (spec/04-expressions.md).
pub trait Ord {
    fn cmp(self, other: Self) -> Ordering;
}

/// Rendering a value as text. `io::println` takes a `String`, so `to_str` is how
/// anything else reaches it.
pub trait Show {
    fn to_str(self) -> String;
}

/// A sequence that can be advanced. Drives `for` together with `IntoIterator`.
pub trait Iterator {
    type Item;
    fn next(mut self) -> Option[Self::Item];
}

/// Anything a `for` loop can walk.
pub trait IntoIterator {
    type Item;
    type Iter: Iterator;
    fn into_iter(self) -> Self::Iter;
}

/// Arithmetic that does not trap, for when wrapping, checking or saturating is what you
/// actually want. `+ - *` trap on overflow (ADR-0005); these are the explicit
/// alternatives. The compiler implements this trait for every integer type.
pub trait Int {
    fn wrapping_add(self, other: Self) -> Self;
    fn wrapping_sub(self, other: Self) -> Self;
    fn wrapping_mul(self, other: Self) -> Self;

    fn checked_add(self, other: Self) -> Option[Self];
    fn checked_sub(self, other: Self) -> Option[Self];
    fn checked_mul(self, other: Self) -> Option[Self];

    fn saturating_add(self, other: Self) -> Self;
    fn saturating_sub(self, other: Self) -> Self;
    fn saturating_mul(self, other: Self) -> Self;
}

/// A marker for values that may cross a channel (spec/08-memory-model.md, ADR-0014).
/// It is derived, not implemented by hand: a type is `Send` when it has no `mut` field
/// and its fields are all `Send`.
pub trait Send {
}

// --- Concurrency (spec/12-concurrency.md, ADR-0025) -------------------------------
//
// These four types are handles to objects the runtime owns: a scheduled thread, the two
// ends of a channel, and a lock. The handle field is an index into the runtime's own
// table, not an address, so a forged one is a lookup that fails rather than a wild
// pointer -- every operation below TRAPS on a handle the runtime does not know.
//
// The runtime never builds one of these. A compiler-provided operation returns a bare
// handle or a bare value, and the wrapping into `JoinHandle[T]`, `Option[T]` and the rest
// happens in Origin -- here, or in the compiler where a call's own checked type says
// which instantiation to construct. That is what lets three engines share one design:
// the native backend has no notion of "the prelude's `Option`" to build from machine
// code, and now it never needs one.

/// A running thread and the value it will return.
pub struct JoinHandle[T] {
    handle: i64,
}

impl[T] JoinHandle[T] {
    /// Blocks until the thread finishes, and yields its result. TRAPS if this handle has
    /// already been joined.
    pub fn join(self) -> T {
        thread::join_thread(self)
    }
}

/// The sending end of a channel.
pub struct Sender[T] {
    handle: i64,
}

impl[T] Sender[T] {
    /// Blocks while the channel is full. TRAPS if the channel is closed.
    pub fn send(self, value: T) {
        chan::send_value(self, value)
    }

    /// Marks the channel closed. Queued values remain receivable. TRAPS if already closed.
    pub fn close(self) {
        chan::close_sender(self)
    }
}

/// The receiving end of a channel.
pub struct Receiver[T] {
    handle: i64,
}

impl[T] Receiver[T] {
    /// Blocks while the channel is empty. `None` once the channel is closed and drained,
    /// and permanently thereafter.
    ///
    /// The two operations are one atomic step, not two: `await_value` dequeues under the
    /// runtime's own lock and holds the value for this thread, and `taken_value` reads
    /// what it took. Asking "is there a value?" and then taking one would be a race
    /// between two receivers.
    pub fn recv(self) -> Option[T] {
        if chan::await_value(self) {
            Option::Some(chan::taken_value(self))
        } else {
            Option::None
        }
    }
}

/// A lock guarding a value. The only way to share mutable state between threads
/// (ADR-0014), and the only reason a type with `mut` fields can cross a thread boundary.
pub struct Mutex[T] {
    handle: i64,
}

impl[T] Mutex[T] {
    /// Acquires the lock, calls `body` with the guarded value, releases the lock, and
    /// returns what `body` returned. TRAPS if the calling thread already holds this lock.
    pub fn with[R](self, body: fn(T) -> R) -> R {
        sync::with_lock(self, body)
    }
}

// --- Collections (spec/13-collections.md, ADR-0028) --------------------------------
//
// A list is Origin source over one compiler-provided primitive, `Array[T]`: a run of
// elements with a length and a capacity, where a slot exists only once something has been
// pushed to it. That is the whole reason the primitive is shaped that way -- it is what
// lets a growable structure hold no value that nothing wrote, which ADR-0007 leaves no
// room for, and it is what makes `==` on two lists compare their elements rather than
// their spare room.
//
// `list::new[T]()` is the constructor. It is a compiler-provided operation only because a
// language without associated functions has nowhere to put `List::new` (docs/deferred.md);
// what it builds is this struct, from Origin's own `Array`.

/// A growable sequence of `T`.
///
/// It has a `mut` field, so it is not `Send` (ADR-0014): a list cannot cross a channel,
/// because two threads sharing a growable buffer is exactly the race `Send` refuses. A
/// `Mutex[List[T]]` is how a list is shared.
/// A slot two names can share.
///
/// A lambda captures by value (spec/04-expressions.md), so it cannot reassign the binding
/// it captured. What it *can* do is capture a reference to an aggregate and mutate a `mut`
/// field through it, because a copy of a reference still points at the same object
/// (ADR-0008). That is the whole content of this type: one `mut` field, so that "share a
/// mutable slot" has a name rather than being a struct every program declares for itself.
pub struct Cell[T] {
    mut value: T,
}

impl[T] Cell[T] {
    /// What the cell holds.
    pub fn get(self) -> T {
        self.value
    }

    /// Replaces what the cell holds.
    pub fn set(self, v: T) {
        self.value = v
    }

    /// Replaces what the cell holds and answers what it held.
    pub fn replace(self, v: T) -> T {
        let had = self.value;
        self.value = v;
        had
    }
}

pub struct List[T] {
    mut buf: Array[T],
}

impl[T] List[T] {
    /// How many elements the list holds.
    pub fn len(self) -> i64 {
        array::len(self.buf)
    }

    /// Whether the list holds none.
    pub fn is_empty(self) -> bool {
        array::len(self.buf) == 0
    }

    /// Appends an element, growing the buffer when it is full. The capacity doubles, so
    /// `n` pushes cost O(n) rather than O(n²).
    pub fn push(self, v: T) {
        if array::push(self.buf, v) {
            return;
        }
        let n = array::len(self.buf);
        let bigger = array::new[T](n * 2 + 4);
        let mut i = 0;
        while i < n {
            array::push(bigger, array::at(self.buf, i));
            i = i + 1;
        }
        array::push(bigger, v);
        self.buf = bigger;
    }

    /// The element at `i`, or `None` when there is none there.
    pub fn get(self, i: i64) -> Option[T] {
        if i < 0 {
            return Option::None;
        }
        if i >= array::len(self.buf) {
            return Option::None;
        }
        Option::Some(array::at(self.buf, i))
    }

    /// The element at `i`. TRAPS `index out of range` when there is none there.
    pub fn at(self, i: i64) -> T {
        array::at(self.buf, i)
    }

    /// Replaces the element at `i`. TRAPS `index out of range` when there is none there.
    pub fn set(self, i: i64, v: T) {
        array::set(self.buf, i, v)
    }

    /// Removes and returns the last element, or `None` when the list is empty.
    pub fn pop(self) -> Option[T] {
        let n = array::len(self.buf);
        if n == 0 {
            return Option::None;
        }
        let last = array::at(self.buf, n - 1);
        array::truncate(self.buf, n - 1);
        Option::Some(last)
    }

    /// Drops every element, keeping the room they were in.
    pub fn clear(self) {
        array::truncate(self.buf, 0)
    }
}

/// Walks a list front to back. It reads the list as it goes, so it yields what the list
/// holds when each step runs.
pub struct ListIter[T] {
    list: List[T],
    mut i: i64,
}

impl[T] Iterator for ListIter[T] {
    type Item = T;
    fn next(mut self) -> Option[T] {
        if self.i >= self.list.len() {
            return Option::None;
        }
        let v = self.list.at(self.i);
        self.i = self.i + 1;
        Option::Some(v)
    }
}

impl[T] IntoIterator for List[T] {
    type Item = T;
    type Iter = ListIter[T];
    fn into_iter(self) -> ListIter[T] {
        ListIter { list: self, i: 0 }
    }
}

/// One key and the value it maps to. `Map` hands these out in insertion order.
pub struct Entry[K, V] {
    key: K,
    mut value: V,
}

/// A keyed lookup that iterates in insertion order (spec/13-collections.md).
///
/// Two structures, not one: `entries` is the insertion order and is what iteration walks,
/// and `index` is an open-addressed table of `1 + position` into it, which is what makes a
/// lookup a probe rather than a scan. A zero slot in `index` is an empty one, which is why
/// the positions are stored one higher than they are.
///
/// The insertion order is a promise the language makes rather than an accident: a hash
/// order would differ between the three engines, and a program that printed a map would
/// then not be a valid differential case.
pub struct Map[K, V] {
    mut entries: List[Entry[K, V]],
    mut index: Array[i64],
}

impl[K, V] Map[K, V] {
    /// How many entries the map holds.
    pub fn len(self) -> i64 {
        self.entries.len()
    }

    /// Whether the map holds none.
    pub fn is_empty(self) -> bool {
        self.entries.len() == 0
    }

    /// Where `k` would sit in the index: the slot holding it, or the first empty slot on
    /// its probe path. The table is never full when this is called -- `insert` grows it
    /// first -- so the walk always ends.
    fn probe(self, k: K) -> i64 {
        let cap = array::cap(self.index);
        let mut i = hash::of(k);
        if i < 0 {
            i = 0 - i;
        }
        i = i % cap;
        while true {
            let slot = array::at(self.index, i);
            if slot == 0 {
                return i;
            }
            if self.entries.at(slot - 1).key == k {
                return i;
            }
            i = i + 1;
            if i == cap {
                i = 0;
            }
        }
        0
    }

    /// Doubles the index and re-probes every entry into it. The entries themselves do not
    /// move: their order is the map's own, and rebuilding it would lose it.
    fn regrow(self) {
        let want = array::cap(self.index) * 2;
        let fresh = array::new[i64](want);
        let mut i = 0;
        while i < want {
            array::push(fresh, 0);
            i = i + 1;
        }
        self.index = fresh;

        let mut e = 0;
        while e < self.entries.len() {
            let at = self.probe(self.entries.at(e).key);
            array::set(self.index, at, e + 1);
            e = e + 1;
        }
    }

    /// Adds `k`, or replaces what it mapped to. Returns the value it replaced, if any; the
    /// entry keeps the position it was first inserted at.
    pub fn insert(self, k: K, v: V) -> Option[V] {
        // Keep the table under half full, so a probe is short and always finds a gap.
        if (self.entries.len() + 1) * 2 >= array::cap(self.index) {
            self.regrow();
        }
        let at = self.probe(k);
        let slot = array::at(self.index, at);
        if slot == 0 {
            self.entries.push(Entry { key: k, value: v });
            array::set(self.index, at, self.entries.len());
            return Option::None;
        }
        let entry = self.entries.at(slot - 1);
        let old = entry.value;
        entry.value = v;
        Option::Some(old)
    }

    /// What `k` maps to, or `None`.
    pub fn get(self, k: K) -> Option[V] {
        if self.entries.len() == 0 {
            return Option::None;
        }
        let slot = array::at(self.index, self.probe(k));
        if slot == 0 {
            return Option::None;
        }
        Option::Some(self.entries.at(slot - 1).value)
    }

    /// Whether `k` is in the map.
    pub fn contains(self, k: K) -> bool {
        match self.get(k) {
            Option::Some(v) => true,
            Option::None => false,
        }
    }

    /// Removes `k` and returns what it mapped to, or `None`.
    ///
    /// This rebuilds both structures, which is O(n) where the rest are O(1): a removal has
    /// to close the gap it leaves in the insertion order, and the alternative is a
    /// tombstone in every probe from then on.
    pub fn remove(self, k: K) -> Option[V] {
        if self.entries.len() == 0 {
            return Option::None;
        }
        let slot = array::at(self.index, self.probe(k));
        if slot == 0 {
            return Option::None;
        }
        let gone = self.entries.at(slot - 1).value;

        let kept = list::new[Entry[K, V]]();
        let mut i = 0;
        while i < self.entries.len() {
            if i != slot - 1 {
                kept.push(self.entries.at(i));
            }
            i = i + 1;
        }
        self.entries = kept;

        let fresh = array::new[i64](array::cap(self.index));
        let mut j = 0;
        while j < array::cap(self.index) {
            array::push(fresh, 0);
            j = j + 1;
        }
        self.index = fresh;

        let mut e = 0;
        while e < self.entries.len() {
            let at = self.probe(self.entries.at(e).key);
            array::set(self.index, at, e + 1);
            e = e + 1;
        }
        Option::Some(gone)
    }

    /// Every key, in insertion order.
    pub fn keys(self) -> List[K] {
        let out = list::new[K]();
        let mut i = 0;
        while i < self.entries.len() {
            out.push(self.entries.at(i).key);
            i = i + 1;
        }
        out
    }

    /// Every value, in insertion order.
    pub fn values(self) -> List[V] {
        let out = list::new[V]();
        let mut i = 0;
        while i < self.entries.len() {
            out.push(self.entries.at(i).value);
            i = i + 1;
        }
        out
    }

    /// Drops every entry.
    pub fn clear(self) {
        self.entries = list::new[Entry[K, V]]();
        let fresh = array::new[i64](array::cap(self.index));
        let mut i = 0;
        while i < array::cap(self.index) {
            array::push(fresh, 0);
            i = i + 1;
        }
        self.index = fresh;
    }
}

/// Walks a map's entries in insertion order.
pub struct MapIter[K, V] {
    entries: List[Entry[K, V]],
    mut i: i64,
}

impl[K, V] Iterator for MapIter[K, V] {
    type Item = Entry[K, V];
    fn next(mut self) -> Option[Entry[K, V]] {
        if self.i >= self.entries.len() {
            return Option::None;
        }
        let e = self.entries.at(self.i);
        self.i = self.i + 1;
        Option::Some(e)
    }
}

impl[K, V] IntoIterator for Map[K, V] {
    type Item = Entry[K, V];
    type Iter = MapIter[K, V];
    fn into_iter(self) -> MapIter[K, V] {
        MapIter { entries: self.entries, i: 0 }
    }
}

// --- Strings (spec/14-strings.md) --------------------------------------------------
//
// `String` is a primitive, so there is no struct to hang an inherent impl on and no way to
// write `s.len()` without a trait. `Str` is that trait: six operations the compiler
// provides, because their bodies read or allocate raw bytes, and everything else written
// here in Origin over exactly those six.
//
// The division is the same one ADR-0028 drew for collections, and the claim is the same:
// from outside, the two halves are indistinguishable. `slice` is machine code and `split`
// is the twenty lines below it, and a program cannot tell which is which.

/// Text operations on `String` (spec/14-strings.md).
///
/// Indices are **byte** indices unless a method says otherwise. Byte indexing is O(1) and
/// is what a tokenizer wants; `char_at` and `chars` are how the characters are reached. An
/// index that would split a character TRAPS rather than producing invalid UTF-8, because
/// `==`, ordering, hashing and printing all assume a `String` is valid text.
pub trait Str {
    /// The length in bytes.
    fn len(self) -> i64;

    /// The byte at `i`, in `0..=255`. TRAPS `index out of range`.
    fn byte_at(self, i: i64) -> i64;

    /// The bytes in `[start, end)`. TRAPS `index out of range`, or
    /// `string index is not a character boundary`.
    fn slice(self, start: i64, end: i64) -> String;

    /// `self` followed by `other`.
    fn concat(self, other: String) -> String;

    /// The character whose encoding starts at byte `i`. TRAPS `index out of range`, or
    /// `string index is not a character boundary`.
    fn char_at(self, i: i64) -> char;

    /// How many bytes the character at `i` occupies: 1, 2, 3 or 4. Same traps as `char_at`.
    fn char_width(self, i: i64) -> i64;

    /// Whether there are no bytes at all.
    fn is_empty(self) -> bool {
        self.len() == 0
    }

    /// `self` as a `String`.
    ///
    /// Inside a default body `self` has type `Self`, not `String`, so this is what the
    /// bodies below use wherever one is called for. For `String` itself it is a copy of
    /// the whole thing, which is what makes it total for a future implementor whose
    /// representation is not a `String` at all.
    fn as_string(self) -> String {
        self.slice(0, self.len())
    }

    /// How many characters. This is `len()` only for text that is entirely ASCII.
    fn char_count(self) -> i64 {
        let mut n = 0;
        let mut i = 0;
        while i < self.len() {
            i = i + self.char_width(i);
            n = n + 1;
        }
        n
    }

    /// Whether `self` begins with the bytes of `prefix`.
    fn starts_with(self, prefix: String) -> bool {
        self.matches_at(0, prefix)
    }

    /// Whether `self` ends with the bytes of `suffix`.
    fn ends_with(self, suffix: String) -> bool {
        if suffix.len() > self.len() {
            return false;
        }
        self.matches_at(self.len() - suffix.len(), suffix)
    }

    /// Whether `needle`'s bytes occur at byte index `at`.
    ///
    /// Comparing bytes rather than slicing is what makes this safe at any index: a slice
    /// whose end fell inside a character would TRAP, and a search has to be able to ask
    /// about a position before it knows whether the answer is yes.
    fn matches_at(self, at: i64, needle: String) -> bool {
        if at + needle.len() > self.len() {
            return false;
        }
        let mut i = 0;
        while i < needle.len() {
            if self.byte_at(at + i) != needle.byte_at(i) {
                return false;
            }
            i = i + 1;
        }
        true
    }

    /// The byte index where `needle` first occurs, or `None`.
    ///
    /// Searching by bytes gives the same answer as searching by characters: UTF-8 is
    /// self-synchronizing, so a valid encoding never occurs inside another one.
    fn find(self, needle: String) -> Option[i64] {
        if needle.len() > self.len() {
            return Option::None;
        }
        let last = self.len() - needle.len();
        let mut at = 0;
        while at <= last {
            if self.matches_at(at, needle) {
                return Option::Some(at);
            }
            at = at + 1;
        }
        Option::None
    }

    /// Whether `needle` occurs anywhere in `self`.
    fn contains(self, needle: String) -> bool {
        match self.find(needle) {
            Option::Some(_) => true,
            Option::None => false,
        }
    }

    /// The pieces between occurrences of `sep`: one more piece than separators found.
    ///
    /// An empty separator has no occurrences to find, so the whole string is one piece.
    fn split(self, sep: String) -> List[String] {
        let out = list::new[String]();
        if sep.is_empty() {
            out.push(self.as_string());
            return out;
        }
        // `at` only ever moves by a whole character or past a whole separator, so it is
        // always a character boundary and every slice below is legal. Testing for the
        // separator by bytes rather than by slicing is what makes that possible: a slice
        // at a mid-character offset would TRAP before the comparison ever happened.
        let mut start = 0;
        let mut at = 0;
        while at + sep.len() <= self.len() {
            if self.matches_at(at, sep) {
                out.push(self.slice(start, at));
                at = at + sep.len();
                start = at;
            } else {
                at = at + self.char_width(at);
            }
        }
        out.push(self.slice(start, self.len()));
        out
    }

    /// The characters, in order.
    fn chars(self) -> List[char] {
        let out = list::new[char]();
        let mut i = 0;
        while i < self.len() {
            out.push(self.char_at(i));
            i = i + self.char_width(i);
        }
        out
    }

    /// `self` joined to itself `n` times. `n <= 0` gives the empty string.
    fn repeat(self, n: i64) -> String {
        // By doubling, not by `n` concatenations. Each `concat` copies both operands, so
        // appending one piece at a time copies the whole accumulated string every time --
        // quadratic, and visibly so: a 128 KiB string took longer to build than the rest
        // of the end-to-end suite took to run. Binary exponentiation makes it O(log n)
        // concatenations of geometrically growing pieces instead.
        if n <= 0 {
            return "";
        }
        let mut out = "";
        let mut acc = self.as_string();
        let mut k = n;
        while k > 0 {
            if k - (k / 2) * 2 == 1 {
                out = out.concat(acc);
            }
            k = k / 2;
            if k > 0 {
                acc = acc.concat(acc);
            }
        }
        out
    }

    /// `self` without leading ASCII whitespace: space, tab, newline, carriage return.
    fn trim_start(self) -> String {
        let mut i = 0;
        while i < self.len() && is_ascii_space(self.byte_at(i)) {
            i = i + 1;
        }
        self.slice(i, self.len())
    }

    /// `self` without trailing ASCII whitespace.
    fn trim_end(self) -> String {
        let mut n = self.len();
        while n > 0 && is_ascii_space(self.byte_at(n - 1)) {
            n = n - 1;
        }
        self.slice(0, n)
    }

    /// `self` without whitespace at either end.
    fn trim(self) -> String {
        self.trim_start().trim_end()
    }

    /// The decimal integer `self` denotes, or `None`.
    ///
    /// An optional `-` or `+`, then one or more ASCII digits, then nothing. A value too
    /// large for an `i64` is `None` rather than a trap: overflow here is a property of the
    /// input, and `checked_mul`/`checked_add` are what keep it one.
    fn parse_int(self) -> Option[i64] {
        if self.is_empty() {
            return Option::None;
        }
        let mut i = 0;
        let mut negative = false;
        let first = self.byte_at(0);
        if first == 45 {
            negative = true;
            i = 1;
        } else {
            if first == 43 {
                i = 1;
            }
        }
        if i >= self.len() {
            return Option::None;
        }
        // Accumulating the magnitude as a negative number is what lets `i64::MIN` parse:
        // its magnitude has no positive representation, and its own negation is itself.
        let mut acc = 0;
        while i < self.len() {
            let b = self.byte_at(i);
            if b < 48 || b > 57 {
                return Option::None;
            }
            let digit = b - 48;
            match acc.checked_mul(10) {
                Option::None => { return Option::None; }
                Option::Some(scaled) => {
                    match scaled.checked_sub(digit) {
                        Option::None => { return Option::None; }
                        Option::Some(next) => { acc = next; }
                    }
                }
            }
            i = i + 1;
        }
        if negative {
            return Option::Some(acc);
        }
        // `acc` is the magnitude, accumulated negative; negating it is the only step that
        // can fail, and only for `i64::MIN`, whose magnitude has no positive value.
        0.checked_sub(acc)
    }

    /// The float `self` denotes, or `None`.
    ///
    /// An optional sign, then digits with an optional point, then an optional decimal
    /// exponent -- the same shape a float literal has (spec/01-lexical.md), with a sign
    /// allowed in front because a literal's is a separate operator and a string's is not.
    /// Digit separators are not accepted: they are a feature of source text.
    ///
    /// The result is the binary64 *nearest* the exact decimal value, ties to even. That is
    /// the same rule parsing a literal follows, which makes this the exact inverse of
    /// `to_str` (spec/16-floats.md): every finite float printed and read back is itself.
    fn parse_float(self) -> Option[f64] {
        let mut i = 0;
        let mut negative = false;
        if i < self.len() {
            let first = self.byte_at(i);
            if first == 45 {
                negative = true;
                i = 1;
            } else {
                if first == 43 {
                    i = 1;
                }
            }
        }

        // The digits, point ignored, as one arbitrary-precision integer; `exp10` counts
        // what the point and the exponent together do to it.
        let mut digits = list::new[i64]();
        let mut any = false;
        let mut exp10 = 0;
        while i < self.len() && is_ascii_digit(self.byte_at(i)) {
            digits = big_mul_small(digits, 10);
            digits = big_add(digits, big_of(self.byte_at(i) - 48));
            any = true;
            i = i + 1;
        }
        if i < self.len() && self.byte_at(i) == 46 {
            i = i + 1;
            while i < self.len() && is_ascii_digit(self.byte_at(i)) {
                digits = big_mul_small(digits, 10);
                digits = big_add(digits, big_of(self.byte_at(i) - 48));
                exp10 = exp10 - 1;
                any = true;
                i = i + 1;
            }
        }
        if !any {
            return Option::None;
        }

        if i < self.len() && (self.byte_at(i) == 101 || self.byte_at(i) == 69) {
            i = i + 1;
            let mut exp_negative = false;
            if i < self.len() && self.byte_at(i) == 45 {
                exp_negative = true;
                i = i + 1;
            } else {
                if i < self.len() && self.byte_at(i) == 43 {
                    i = i + 1;
                }
            }
            let mut written = 0;
            let mut exponent = 0;
            while i < self.len() && is_ascii_digit(self.byte_at(i)) {
                // Clamping rather than trapping: an exponent this large is an infinity or
                // a zero whatever its remaining digits say.
                if exponent < 100000 {
                    exponent = exponent * 10 + (self.byte_at(i) - 48);
                }
                written = written + 1;
                i = i + 1;
            }
            if written == 0 {
                return Option::None;
            }
            if exp_negative {
                exp10 = exp10 - exponent;
            } else {
                exp10 = exp10 + exponent;
            }
        }
        if i != self.len() {
            return Option::None;
        }
        Option::Some(decimal_to_float(negative, big_trim(digits), exp10))
    }
}

impl Str for String {
    fn len(self) -> i64 { str::len(self) }
    fn byte_at(self, i: i64) -> i64 { str::byte_at(self, i) }
    fn slice(self, start: i64, end: i64) -> String { str::slice(self, start, end) }
    fn concat(self, other: String) -> String { str::concat(self, other) }
    fn char_at(self, i: i64) -> char { str::char_at(self, i) }
    fn char_width(self, i: i64) -> i64 { str::char_width(self, i) }
}

/// Whether a byte is an ASCII decimal digit.
fn is_ascii_digit(b: i64) -> bool {
    b >= 48 && b <= 57
}

/// Whether a byte is ASCII space, tab, newline or carriage return.
fn is_ascii_space(b: i64) -> bool {
    b == 32 || b == 9 || b == 10 || b == 13
}

// --- Files (spec/15-files.md) ------------------------------------------------------
//
// A whole file at a time, and no handle. A handle would be a resource Origin has no way to
// close automatically -- there are no destructors and no `defer`, and the collector is not
// a schedule -- so a leaked descriptor would be exactly the quiet failure this language
// exists to not have.
//
// The compiler provides four operations whose bodies are system calls. Each returns a
// status or a primitive rather than a `Result`, for the reason every other one does: the
// native backend has no way to construct a prelude type, so the `Result` is built here.

/// What went wrong with a file operation (spec/15-files.md).
///
/// Three cases, because they are the three a program acts on differently. There is no
/// errno: a number the system happened to use is not something a program should branch on.
pub enum IoError {
    NotFound,
    PermissionDenied,
    Other,
}

impl Show for IoError {
    fn to_str(self) -> String {
        match self {
            IoError::NotFound => "not found",
            IoError::PermissionDenied => "permission denied",
            IoError::Other => "I/O error",
        }
    }
}

/// The status codes `std::fs` returns, turned into the error a program matches on.
fn io_error_of(status: i64) -> IoError {
    match status {
        1 => IoError::NotFound,
        2 => IoError::PermissionDenied,
        _ => IoError::Other,
    }
}

/// Whether a run of bytes is well-formed UTF-8 (spec/14-strings.md's encoding table).
///
/// It is written here, in Origin, rather than three times over in three runtimes: the
/// answer has to be the same on every engine, and one implementation is how that is made
/// true rather than checked. Overlong encodings, surrogates and anything past U+10FFFF are
/// rejected, which is what makes "a `String` is valid UTF-8" mean something.
fn is_valid_utf8(s: String) -> bool {
    let mut i = 0;
    while i < s.len() {
        let b = s.byte_at(i);
        let mut width = 0;
        let mut lo = 0;
        let mut scalar = 0;
        if b < 128 {
            i = i + 1;
            continue;
        }
        if b >= 194 && b <= 223 {
            width = 2;
            lo = 128;
            scalar = b - 192;
        } else {
            if b >= 224 && b <= 239 {
                width = 3;
                lo = 2048;
                scalar = b - 224;
            } else {
                if b >= 240 && b <= 244 {
                    width = 4;
                    lo = 65536;
                    scalar = b - 240;
                } else {
                    return false;
                }
            }
        }
        if i + width > s.len() {
            return false;
        }
        let mut k = 1;
        while k < width {
            let c = s.byte_at(i + k);
            if c < 128 || c > 191 {
                return false;
            }
            scalar = scalar * 64 + (c - 128);
            k = k + 1;
        }
        if scalar < lo {
            return false; // an overlong encoding of something shorter
        }
        if scalar > 1114111 {
            return false;
        }
        if scalar >= 55296 && scalar <= 57343 {
            return false; // a surrogate, which is not a scalar value
        }
        i = i + width;
    }
    true
}

/// The whole file, as text.
///
/// A file whose bytes are not valid UTF-8 is `Err(Other)` rather than a `String` that
/// lies: every other part of the language assumes a `String` is valid text (spec/14).
pub fn read_to_string(path: String) -> Result[String, IoError] {
    let status = fs::read_file(path);
    if status != 0 {
        return Result::Err(io_error_of(status));
    }
    let text = fs::taken_text();
    if !is_valid_utf8(text) {
        return Result::Err(IoError::Other);
    }
    Result::Ok(text)
}

/// Writes the whole file, creating it if it does not exist and truncating it if it does.
pub fn write_string(path: String, contents: String) -> Result[(), IoError] {
    let status = fs::write_file(path, contents);
    if status != 0 {
        return Result::Err(io_error_of(status));
    }
    Result::Ok(())
}

/// Whether the path can be opened for reading. Never an error: a path that cannot be read
/// is exactly what `false` means here.
pub fn file_exists(path: String) -> bool {
    fs::file_exists(path)
}

// --- Rendering a float (spec/16-floats.md) -----------------------------------------
//
// `to_str` on a float produces the shortest decimal that reads back as the same value.
// That is not a formatting detail: it is a fact about the number, and finding it needs
// exact arithmetic on integers far wider than sixty-four bits.
//
// So it is written here, in Origin, over the two operations the compiler provides for it
// (`float::bits` and `float::from_bits`, which reinterpret the same sixty-four bits). One
// implementation the interpreter, the virtual machine and native code all run, rather than
// three that would have to be argued into agreeing -- and, for the native backend, rather
// than a shortest-round-trip algorithm hand-written in machine code (ADR-0031).
//
// The algorithm is Steele & White's free-format conversion in Burger & Dybvig's form: keep
// the value and the two half-gaps to its neighbours as exact rationals, scale them so the
// first digit is the first one that matters, and emit digits until the remainder is close
// enough to one neighbour that no further digit could change which float the string reads
// back as.

/// The number of digits a `Big` limb holds, and the base it counts in.
///
/// Base 10^9 rather than a power of two because every intermediate has to fit in an `i64`:
/// a limb times the base is 10^18, and 10^18 plus a carry is still under `i64::MAX`. A
/// wider base would overflow, and overflow traps.
fn big_base() -> i64 {
    1000000000
}

/// A non-negative integer of unbounded size: limbs in base 10^9, least significant first,
/// with no zero limb on the end. The empty list is zero.
///
/// Every function below builds a fresh list and never writes through its arguments, so two
/// names for one `Big` are always safe.
fn big_trim(a: List[i64]) -> List[i64] {
    while a.len() > 0 && a.at(a.len() - 1) == 0 {
        a.pop();
    }
    a
}

/// `n` as a `Big`. `n` must not be negative.
fn big_of(n: i64) -> List[i64] {
    let out = list::new[i64]();
    let mut v = n;
    while v > 0 {
        out.push(v % big_base());
        v = v / big_base();
    }
    out
}

/// `a * m`, for `0 <= m <= 10^9`.
fn big_mul_small(a: List[i64], m: i64) -> List[i64] {
    let out = list::new[i64]();
    let mut carry = 0;
    let mut i = 0;
    while i < a.len() {
        let p = a.at(i) * m + carry;
        out.push(p % big_base());
        carry = p / big_base();
        i = i + 1;
    }
    while carry > 0 {
        out.push(carry % big_base());
        carry = carry / big_base();
    }
    big_trim(out)
}

/// `a * 2^n`, for `n >= 0`.
///
/// In chunks of twenty-nine bits, which is the widest multiplier that keeps a limb times it
/// inside an `i64`.
fn big_mul_pow2(a: List[i64], n: i64) -> List[i64] {
    let mut out = a;
    let mut left = n;
    while left >= 29 {
        out = big_mul_small(out, 536870912);
        left = left - 29;
    }
    if left > 0 {
        out = big_mul_small(out, 1 << left);
    }
    out
}

/// `a * 10^n`, for `n >= 0`. Nine digits at a time, which is exactly one limb.
fn big_mul_pow10(a: List[i64], n: i64) -> List[i64] {
    let mut out = a;
    let mut left = n;
    while left >= 9 {
        out = big_mul_small(out, 1000000000);
        left = left - 9;
    }
    while left > 0 {
        out = big_mul_small(out, 10);
        left = left - 1;
    }
    out
}

/// How many bits `n` occupies. `n` must be positive.
fn bit_length(n: i64) -> i64 {
    let mut v = n;
    let mut bits = 0;
    while v > 0 {
        bits = bits + 1;
        v = v / 2;
    }
    bits
}

/// `a + b`.
fn big_add(a: List[i64], b: List[i64]) -> List[i64] {
    let out = list::new[i64]();
    let mut carry = 0;
    let mut i = 0;
    let mut n = a.len();
    if b.len() > n {
        n = b.len();
    }
    while i < n {
        let mut sum = carry;
        if i < a.len() {
            sum = sum + a.at(i);
        }
        if i < b.len() {
            sum = sum + b.at(i);
        }
        if sum >= big_base() {
            out.push(sum - big_base());
            carry = 1;
        } else {
            out.push(sum);
            carry = 0;
        }
        i = i + 1;
    }
    if carry > 0 {
        out.push(carry);
    }
    big_trim(out)
}

/// `a - b`, which the caller must know is not negative.
fn big_sub(a: List[i64], b: List[i64]) -> List[i64] {
    let out = list::new[i64]();
    let mut borrow = 0;
    let mut i = 0;
    while i < a.len() {
        let mut d = a.at(i) - borrow;
        if i < b.len() {
            d = d - b.at(i);
        }
        if d < 0 {
            d = d + big_base();
            borrow = 1;
        } else {
            borrow = 0;
        }
        out.push(d);
        i = i + 1;
    }
    big_trim(out)
}

/// `-1`, `0` or `1` as `a` is less than, equal to or greater than `b`.
fn big_cmp(a: List[i64], b: List[i64]) -> i64 {
    if a.len() != b.len() {
        if a.len() < b.len() {
            return -1;
        }
        return 1;
    }
    let mut i = a.len();
    while i > 0 {
        i = i - 1;
        if a.at(i) != b.at(i) {
            if a.at(i) < b.at(i) {
                return -1;
            }
            return 1;
        }
    }
    0
}

/// Whether the value's upper neighbour boundary has been reached: `r + mp` against `s`.
///
/// `inclusive` is what decides a tie, and it is the parser's rule read backwards: a decimal
/// exactly halfway between two floats reads back as the one with the even significand, so a
/// boundary counts as reachable exactly when this float's significand is even.
fn big_reaches(r: List[i64], mp: List[i64], s: List[i64], inclusive: bool) -> bool {
    let c = big_cmp(big_add(r, mp), s);
    if inclusive {
        return c >= 0;
    }
    c > 0
}

/// Whether the remainder has fallen to the lower neighbour boundary: `r` against `mm`.
fn big_below(r: List[i64], mm: List[i64], inclusive: bool) -> bool {
    let c = big_cmp(r, mm);
    if inclusive {
        return c <= 0;
    }
    c < 0
}

/// `a / 2`, exactly. `a` is read from the top down so each limb's odd remainder carries
/// into the next.
fn big_halve(a: List[i64]) -> List[i64] {
    let high_first = list::new[i64]();
    let mut carry = 0;
    let mut i = a.len();
    while i > 0 {
        i = i - 1;
        let cur = carry * big_base() + a.at(i);
        high_first.push(cur / 2);
        carry = cur % 2;
    }
    let out = list::new[i64]();
    let mut j = high_first.len();
    while j > 0 {
        j = j - 1;
        out.push(high_first.at(j));
    }
    big_trim(out)
}

/// About how many bits `a` occupies.
///
/// Exact for a single limb and within a bit or two above that, since 29897/1000 is only
/// log2(10^9) to three places. Approximate is enough: the one caller uses it to guess a
/// binary exponent and then corrects the guess by dividing again.
fn big_bit_estimate(a: List[i64]) -> i64 {
    if a.len() == 0 {
        return 0;
    }
    (a.len() - 1) * 29897 / 1000 + bit_length(a.at(a.len() - 1))
}

/// A quotient small enough to hold in a `u64`, and the remainder that is left over.
struct SmallDiv {
    q: u64,
    rem: List[i64],
}

/// `floor(n / d)` and `n mod d`, for a quotient the caller knows fits in `bits + 1` bits.
///
/// Shift and subtract, from the top bit down: the same long division done by hand, with
/// `d` doubled up front and halved on every step so no bit of the dividend has to be
/// addressed directly -- which a base-10^9 representation makes awkward and this makes
/// unnecessary.
fn big_div_bits(n: List[i64], d: List[i64], bits: i64) -> SmallDiv {
    let mut rem = n;
    let mut q = 0u64;
    let mut scaled = big_mul_pow2(d, bits);
    let mut k = bits;
    while k >= 0 {
        if big_cmp(rem, scaled) >= 0 {
            rem = big_sub(rem, scaled);
            q = q + (1u64 << (k as u64));
        }
        scaled = big_halve(scaled);
        k = k - 1;
    }
    SmallDiv { q: q, rem: rem }
}

/// The binary64 nearest to `digits * 10^exp10`, negated when `negative`.
///
/// The exact value is kept as a ratio of two arbitrary-precision integers, so the only
/// rounding that happens is the last one -- which is what "nearest, ties to even" has to
/// mean for this to be the inverse of spec/16-floats.md's rendering.
fn decimal_to_float(negative: bool, digits: List[i64], exp10: i64) -> f64 {
    if digits.len() == 0 {
        if negative {
            return float::from_bits(9223372036854775808u64);
        }
        return 0.0;
    }
    let sign = if negative { 9223372036854775808u64 } else { 0u64 };

    // Where the decimal point sits, roughly: the value is below 10^place and at least
    // 10^(place-1). Past the ends of the binary64 range there is nothing to compute, and
    // the bignums it would take to find that out are enormous.
    let place = exp10 + digits.len() * 9;
    if place > 400 {
        return float::from_bits(sign | 9218868437227405312u64);
    }
    if place < -400 {
        return float::from_bits(sign);
    }

    let mut num = digits;
    let mut den = big_of(1);
    if exp10 >= 0 {
        num = big_mul_pow10(num, exp10);
    } else {
        den = big_mul_pow10(den, 0 - exp10);
    }

    // The significand wants 53 bits, so scale the ratio until the quotient has them. The
    // guess comes from the two bit lengths; the loop below is what makes it exact.
    let mut shift = 52 - (big_bit_estimate(num) - big_bit_estimate(den));
    if shift > 1074 {
        shift = 1074; // below this the result is subnormal and gains no more bits
    }

    let mut bits = 0u64;
    let mut settled = false;
    while !settled {
        let scaled_num = if shift >= 0 { big_mul_pow2(num, shift) } else { num };
        let scaled_den = if shift >= 0 { den } else { big_mul_pow2(den, 0 - shift) };
        // Sixty bits of budget for a quotient that wants fifty-three: the scale came from
        // an estimate, and the correction below needs the true quotient to look at.
        let split = big_div_bits(scaled_num, scaled_den, 60);

        // The range is checked *before* rounding. Checking after was a real bug: the
        // truncated quotient for -1.9999999999999998 at one scale too small is just under
        // 2^52, rounding lifts it to exactly 2^52, and a test that looks at the rounded
        // value sees a number in range and accepts an answer with a bit missing -- which
        // is how that value read back as -2.
        if split.q < 4503599627370496u64 && shift < 1074 {
            shift = shift + 1;
        } else {
            if split.q >= 9007199254740992u64 && shift > -1200 {
                shift = shift - 1;
            } else {
                // Nearest, ties to even, decided against the exact remainder.
                let mut m = split.q;
                let twice = big_mul_small(split.rem, 2);
                let c = big_cmp(twice, scaled_den);
                if c > 0 {
                    m = m + 1u64;
                } else {
                    if c == 0 && m % 2u64 == 1u64 {
                        m = m + 1u64;
                    }
                }
                // Rounding up out of the range carries into the exponent. Halving is exact
                // here -- 2^53 is even -- so there is nothing to round a second time.
                if m == 9007199254740992u64 {
                    m = 4503599627370496u64;
                    shift = shift - 1;
                }

                // exp is the biased exponent this significand and scale denote. A
                // significand below 2^52 is subnormal, whose encoding is the significand
                // itself with an exponent field of zero.
                let exp = 1075 - shift;
                if m >= 4503599627370496u64 {
                    if exp >= 2047 {
                        bits = 9218868437227405312u64;
                    } else {
                        bits = ((exp as u64) << 52u64) | (m - 4503599627370496u64);
                    }
                } else {
                    bits = m;
                }
                settled = true;
            }
        }
    }
    float::from_bits(sign | bits)
}

/// One decimal digit as a one-byte `String`.
fn digit_str(d: i64) -> String {
    "0123456789".slice(d, d + 1)
}

/// The shortest digits of a positive finite float, and where its decimal point goes.
///
/// `f` and `e` are the significand and exponent of `v = f * 2^e`, `asymmetric` says the
/// gap below `v` is half the gap above it (which happens at a power of two that is not the
/// smallest normal), and `inclusive` says the boundaries themselves count.
///
/// Returns the digits; `point` is written into the one-element list `point_out`, because
/// Origin has no tuple field access yet (docs/deferred.md).
fn shortest_digits(f: i64, e: i64, asymmetric: bool, inclusive: bool, point_out: List[i64]) -> String {
    // The value and its two half-gaps as exact rationals over a common denominator:
    // v = r/s, the gap up is mp/s, the gap down is mm/s.
    let mut r = list::new[i64]();
    let mut s = list::new[i64]();
    let mut mp = list::new[i64]();
    let mut mm = list::new[i64]();
    if e >= 0 {
        if asymmetric {
            r = big_mul_pow2(big_of(f), e + 2);
            s = big_of(4);
            mp = big_mul_pow2(big_of(1), e + 1);
            mm = big_mul_pow2(big_of(1), e);
        } else {
            r = big_mul_pow2(big_of(f), e + 1);
            s = big_of(2);
            mp = big_mul_pow2(big_of(1), e);
            mm = big_mul_pow2(big_of(1), e);
        }
    } else {
        if asymmetric {
            r = big_mul_small(big_of(f), 4);
            s = big_mul_pow2(big_of(1), 2 - e);
            mp = big_of(2);
            mm = big_of(1);
        } else {
            r = big_mul_small(big_of(f), 2);
            s = big_mul_pow2(big_of(1), 1 - e);
            mp = big_of(1);
            mm = big_of(1);
        }
    }

    // Scale until 0.d1d2... names the value: the upper boundary must be at most one, and
    // more than a tenth, so the first digit generated is the first significant one.
    //
    // The power of ten to scale by is estimated first, because getting there one factor of
    // ten at a time is three hundred passes over a bignum for a value near either end of
    // the range. 30103/100000 is log10(2) to five places, which puts the estimate within a
    // step or two; the two loops below are what make it exact, and they are written to
    // correct in either direction so that the estimate never has to be trusted.
    let mut point = ((e + bit_length(f) - 1) * 30103) / 100000;
    if point > 0 && ((e + bit_length(f) - 1) * 30103) % 100000 != 0 {
        point = point + 1;
    }
    if point >= 0 {
        s = big_mul_pow10(s, point);
    } else {
        r = big_mul_pow10(r, 0 - point);
        mp = big_mul_pow10(mp, 0 - point);
        mm = big_mul_pow10(mm, 0 - point);
    }

    while big_reaches(r, mp, s, inclusive) {
        s = big_mul_small(s, 10);
        point = point + 1;
    }
    let mut scaled = false;
    while !scaled {
        let r10 = big_mul_small(r, 10);
        let mp10 = big_mul_small(mp, 10);
        if big_reaches(r10, mp10, s, inclusive) {
            scaled = true;
        } else {
            r = r10;
            mp = mp10;
            mm = big_mul_small(mm, 10);
            point = point - 1;
        }
    }

    // Emit digits until one more could not change which float the string reads back as.
    //
    // Rounding the last digit up never carries: the scaling invariant makes the digit at
    // most eight whenever the upper boundary has been reached, so `d + 1` is at most nine.
    let mut out = "";
    let mut done = false;
    while !done {
        r = big_mul_small(r, 10);
        mp = big_mul_small(mp, 10);
        mm = big_mul_small(mm, 10);
        let mut d = 0;
        while big_cmp(r, s) >= 0 {
            r = big_sub(r, s);
            d = d + 1;
        }
        let low = big_below(r, mm, inclusive);
        let high = big_reaches(r, mp, s, inclusive);
        if !low && !high {
            out = out.concat(digit_str(d));
        } else {
            if low && !high {
                out = out.concat(digit_str(d));
            } else {
                if high && !low {
                    out = out.concat(digit_str(d + 1));
                } else {
                    // Both boundaries are in reach, so either digit reads back as this
                    // float and the nearer one wins. An exact tie goes to the even digit,
                    // which is the rule parsing uses read backwards (spec/16-floats.md).
                    let half = big_cmp(big_mul_small(r, 2), s);
                    if half < 0 || (half == 0 && d % 2 == 0) {
                        out = out.concat(digit_str(d));
                    } else {
                        out = out.concat(digit_str(d + 1));
                    }
                }
            }
            done = true;
        }
    }
    point_out.push(point);
    out
}

/// Lays digits out as spec/16-floats.md's table says, given the decimal point position.
fn layout_decimal(digits: String, point: i64) -> String {
    let n = digits.len();
    let e = point - 1;

    if e < -4 || e >= 6 {
        let mut out = digits.slice(0, 1);
        if n > 1 {
            out = out.concat(".").concat(digits.slice(1, n));
        }
        out = out.concat("e");
        let mut mag = e;
        if e < 0 {
            out = out.concat("-");
            mag = 0 - e;
        } else {
            out = out.concat("+");
        }
        let tail = mag.to_str();
        if tail.len() < 2 {
            out = out.concat("0");
        }
        return out.concat(tail);
    }

    if point <= 0 {
        let mut out = "0.";
        let mut i = point;
        while i < 0 {
            out = out.concat("0");
            i = i + 1;
        }
        return out.concat(digits);
    }

    if point >= n {
        // Nothing after the point, so this is the one layout that needs the `.0` that
        // keeps a float from being read as an integer.
        let mut out = digits;
        let mut i = n;
        while i < point {
            out = out.concat("0");
            i = i + 1;
        }
        return out.concat(".0");
    }

    digits.slice(0, point).concat(".").concat(digits.slice(point, n))
}

/// The decimal rendering of a float (spec/16-floats.md).
pub fn float_to_str(v: f64) -> String {
    let bits = float::bits(v);
    let negative = (bits >> 63u64) == 1u64;
    let biased = ((bits >> 52u64) & 2047u64) as i64;
    let frac = (bits & 4503599627370495u64) as i64;

    if biased == 2047 {
        if frac != 0 {
            return "NaN";
        }
        if negative {
            return "-Inf";
        }
        return "+Inf";
    }

    // The significand as an integer, and the power of two it is scaled by. A subnormal has
    // no implicit leading one and shares the smallest normal's exponent.
    let mut f = frac;
    let mut e = -1074;
    if biased != 0 {
        f = frac + 4503599627370496;
        e = biased - 1075;
    }

    if f == 0 {
        if negative {
            return "-0.0";
        }
        return "0.0";
    }

    // The gap below a power of two is half the gap above it, except at the smallest normal,
    // whose neighbour below is the largest subnormal one gap away.
    let asymmetric = frac == 0 && biased >= 2;
    let point_out = list::new[i64]();
    let digits = shortest_digits(f, e, asymmetric, f % 2 == 0, point_out);
    let body = layout_decimal(digits, point_out.at(0));
    if negative {
        return "-".concat(body);
    }
    body
}

impl Show for f64 {
    fn to_str(self) -> String {
        float_to_str(self)
    }
}

impl Show for f32 {
    fn to_str(self) -> String {
        float_to_str(self as f64)
    }
}
