// The Origin prelude, in scope in every module without a `use`.
//
// The types and traits here are written in Origin, not built into the compiler, so that
// the language's own vocabulary goes through the same lexer, parser, resolver and
// checker as user code.
//
// The traits declare their signatures; the impls for primitive types are provided by the
// compiler (see internal/check's builtin impl table) because they cannot be written in
// Origin until the standard library exists in Phase 7. `Hash` waits for `Hasher`, which
// waits for Phase 7 as well.

use std::thread;
use std::chan;
use std::sync;
use std::array;
use std::list;
use std::hash;
use std::str;
use std::fs;

pub enum Option[T] {
    None,
    Some(T),
}

pub enum Result[T, E] {
    Ok(T),
    Err(E),
}

pub enum Ordering {
    Less,
    Equal,
    Greater,
}

/// Total ordering. `<` and friends are built in for primitives; user types compare
/// through `cmp` (spec/04-expressions.md).
pub trait Ord {
    fn cmp(self, other: Self) -> Ordering;
}

/// Rendering a value as text. `io::println` takes a `String`, so `to_str` is how
/// anything else reaches it.
pub trait Show {
    fn to_str(self) -> String;
}

/// A sequence that can be advanced. Drives `for` together with `IntoIterator`.
pub trait Iterator {
    type Item;
    fn next(mut self) -> Option[Self::Item];
}

/// Anything a `for` loop can walk.
pub trait IntoIterator {
    type Item;
    type Iter: Iterator;
    fn into_iter(self) -> Self::Iter;
}

/// Arithmetic that does not trap, for when wrapping, checking or saturating is what you
/// actually want. `+ - *` trap on overflow (ADR-0005); these are the explicit
/// alternatives. The compiler implements this trait for every integer type.
pub trait Int {
    fn wrapping_add(self, other: Self) -> Self;
    fn wrapping_sub(self, other: Self) -> Self;
    fn wrapping_mul(self, other: Self) -> Self;

    fn checked_add(self, other: Self) -> Option[Self];
    fn checked_sub(self, other: Self) -> Option[Self];
    fn checked_mul(self, other: Self) -> Option[Self];

    fn saturating_add(self, other: Self) -> Self;
    fn saturating_sub(self, other: Self) -> Self;
    fn saturating_mul(self, other: Self) -> Self;
}

/// A marker for values that may cross a channel (spec/08-memory-model.md, ADR-0014).
/// It is derived, not implemented by hand: a type is `Send` when it has no `mut` field
/// and its fields are all `Send`.
pub trait Send {
}

// --- Concurrency (spec/12-concurrency.md, ADR-0025) -------------------------------
//
// These four types are handles to objects the runtime owns: a scheduled thread, the two
// ends of a channel, and a lock. The handle field is an index into the runtime's own
// table, not an address, so a forged one is a lookup that fails rather than a wild
// pointer -- every operation below TRAPS on a handle the runtime does not know.
//
// The runtime never builds one of these. A compiler-provided operation returns a bare
// handle or a bare value, and the wrapping into `JoinHandle[T]`, `Option[T]` and the rest
// happens in Origin -- here, or in the compiler where a call's own checked type says
// which instantiation to construct. That is what lets three engines share one design:
// the native backend has no notion of "the prelude's `Option`" to build from machine
// code, and now it never needs one.

/// A running thread and the value it will return.
pub struct JoinHandle[T] {
    handle: i64,
}

impl[T] JoinHandle[T] {
    /// Blocks until the thread finishes, and yields its result. TRAPS if this handle has
    /// already been joined.
    pub fn join(self) -> T {
        thread::join_thread(self)
    }
}

/// The sending end of a channel.
pub struct Sender[T] {
    handle: i64,
}

impl[T] Sender[T] {
    /// Blocks while the channel is full. TRAPS if the channel is closed.
    pub fn send(self, value: T) {
        chan::send_value(self, value)
    }

    /// Marks the channel closed. Queued values remain receivable. TRAPS if already closed.
    pub fn close(self) {
        chan::close_sender(self)
    }
}

/// The receiving end of a channel.
pub struct Receiver[T] {
    handle: i64,
}

impl[T] Receiver[T] {
    /// Blocks while the channel is empty. `None` once the channel is closed and drained,
    /// and permanently thereafter.
    ///
    /// The two operations are one atomic step, not two: `await_value` dequeues under the
    /// runtime's own lock and holds the value for this thread, and `taken_value` reads
    /// what it took. Asking "is there a value?" and then taking one would be a race
    /// between two receivers.
    pub fn recv(self) -> Option[T] {
        if chan::await_value(self) {
            Option::Some(chan::taken_value(self))
        } else {
            Option::None
        }
    }
}

/// A lock guarding a value. The only way to share mutable state between threads
/// (ADR-0014), and the only reason a type with `mut` fields can cross a thread boundary.
pub struct Mutex[T] {
    handle: i64,
}

impl[T] Mutex[T] {
    /// Acquires the lock, calls `body` with the guarded value, releases the lock, and
    /// returns what `body` returned. TRAPS if the calling thread already holds this lock.
    pub fn with[R](self, body: fn(T) -> R) -> R {
        sync::with_lock(self, body)
    }
}

// --- Collections (spec/13-collections.md, ADR-0028) --------------------------------
//
// A list is Origin source over one compiler-provided primitive, `Array[T]`: a run of
// elements with a length and a capacity, where a slot exists only once something has been
// pushed to it. That is the whole reason the primitive is shaped that way -- it is what
// lets a growable structure hold no value that nothing wrote, which ADR-0007 leaves no
// room for, and it is what makes `==` on two lists compare their elements rather than
// their spare room.
//
// `list::new[T]()` is the constructor. It is a compiler-provided operation only because a
// language without associated functions has nowhere to put `List::new` (docs/deferred.md);
// what it builds is this struct, from Origin's own `Array`.

/// A growable sequence of `T`.
///
/// It has a `mut` field, so it is not `Send` (ADR-0014): a list cannot cross a channel,
/// because two threads sharing a growable buffer is exactly the race `Send` refuses. A
/// `Mutex[List[T]]` is how a list is shared.
pub struct List[T] {
    mut buf: Array[T],
}

impl[T] List[T] {
    /// How many elements the list holds.
    pub fn len(self) -> i64 {
        array::len(self.buf)
    }

    /// Whether the list holds none.
    pub fn is_empty(self) -> bool {
        array::len(self.buf) == 0
    }

    /// Appends an element, growing the buffer when it is full. The capacity doubles, so
    /// `n` pushes cost O(n) rather than O(n²).
    pub fn push(self, v: T) {
        if array::push(self.buf, v) {
            return;
        }
        let n = array::len(self.buf);
        let bigger = array::new[T](n * 2 + 4);
        let mut i = 0;
        while i < n {
            array::push(bigger, array::at(self.buf, i));
            i = i + 1;
        }
        array::push(bigger, v);
        self.buf = bigger;
    }

    /// The element at `i`, or `None` when there is none there.
    pub fn get(self, i: i64) -> Option[T] {
        if i < 0 {
            return Option::None;
        }
        if i >= array::len(self.buf) {
            return Option::None;
        }
        Option::Some(array::at(self.buf, i))
    }

    /// The element at `i`. TRAPS `index out of range` when there is none there.
    pub fn at(self, i: i64) -> T {
        array::at(self.buf, i)
    }

    /// Replaces the element at `i`. TRAPS `index out of range` when there is none there.
    pub fn set(self, i: i64, v: T) {
        array::set(self.buf, i, v)
    }

    /// Removes and returns the last element, or `None` when the list is empty.
    pub fn pop(self) -> Option[T] {
        let n = array::len(self.buf);
        if n == 0 {
            return Option::None;
        }
        let last = array::at(self.buf, n - 1);
        array::truncate(self.buf, n - 1);
        Option::Some(last)
    }

    /// Drops every element, keeping the room they were in.
    pub fn clear(self) {
        array::truncate(self.buf, 0)
    }
}

/// Walks a list front to back. It reads the list as it goes, so it yields what the list
/// holds when each step runs.
pub struct ListIter[T] {
    list: List[T],
    mut i: i64,
}

impl[T] Iterator for ListIter[T] {
    type Item = T;
    fn next(mut self) -> Option[T] {
        if self.i >= self.list.len() {
            return Option::None;
        }
        let v = self.list.at(self.i);
        self.i = self.i + 1;
        Option::Some(v)
    }
}

impl[T] IntoIterator for List[T] {
    type Item = T;
    type Iter = ListIter[T];
    fn into_iter(self) -> ListIter[T] {
        ListIter { list: self, i: 0 }
    }
}

/// One key and the value it maps to. `Map` hands these out in insertion order.
pub struct Entry[K, V] {
    key: K,
    mut value: V,
}

/// A keyed lookup that iterates in insertion order (spec/13-collections.md).
///
/// Two structures, not one: `entries` is the insertion order and is what iteration walks,
/// and `index` is an open-addressed table of `1 + position` into it, which is what makes a
/// lookup a probe rather than a scan. A zero slot in `index` is an empty one, which is why
/// the positions are stored one higher than they are.
///
/// The insertion order is a promise the language makes rather than an accident: a hash
/// order would differ between the three engines, and a program that printed a map would
/// then not be a valid differential case.
pub struct Map[K, V] {
    mut entries: List[Entry[K, V]],
    mut index: Array[i64],
}

impl[K, V] Map[K, V] {
    /// How many entries the map holds.
    pub fn len(self) -> i64 {
        self.entries.len()
    }

    /// Whether the map holds none.
    pub fn is_empty(self) -> bool {
        self.entries.len() == 0
    }

    /// Where `k` would sit in the index: the slot holding it, or the first empty slot on
    /// its probe path. The table is never full when this is called -- `insert` grows it
    /// first -- so the walk always ends.
    fn probe(self, k: K) -> i64 {
        let cap = array::cap(self.index);
        let mut i = hash::of(k);
        if i < 0 {
            i = 0 - i;
        }
        i = i % cap;
        while true {
            let slot = array::at(self.index, i);
            if slot == 0 {
                return i;
            }
            if self.entries.at(slot - 1).key == k {
                return i;
            }
            i = i + 1;
            if i == cap {
                i = 0;
            }
        }
        0
    }

    /// Doubles the index and re-probes every entry into it. The entries themselves do not
    /// move: their order is the map's own, and rebuilding it would lose it.
    fn regrow(self) {
        let want = array::cap(self.index) * 2;
        let fresh = array::new[i64](want);
        let mut i = 0;
        while i < want {
            array::push(fresh, 0);
            i = i + 1;
        }
        self.index = fresh;

        let mut e = 0;
        while e < self.entries.len() {
            let at = self.probe(self.entries.at(e).key);
            array::set(self.index, at, e + 1);
            e = e + 1;
        }
    }

    /// Adds `k`, or replaces what it mapped to. Returns the value it replaced, if any; the
    /// entry keeps the position it was first inserted at.
    pub fn insert(self, k: K, v: V) -> Option[V] {
        // Keep the table under half full, so a probe is short and always finds a gap.
        if (self.entries.len() + 1) * 2 >= array::cap(self.index) {
            self.regrow();
        }
        let at = self.probe(k);
        let slot = array::at(self.index, at);
        if slot == 0 {
            self.entries.push(Entry { key: k, value: v });
            array::set(self.index, at, self.entries.len());
            return Option::None;
        }
        let entry = self.entries.at(slot - 1);
        let old = entry.value;
        entry.value = v;
        Option::Some(old)
    }

    /// What `k` maps to, or `None`.
    pub fn get(self, k: K) -> Option[V] {
        if self.entries.len() == 0 {
            return Option::None;
        }
        let slot = array::at(self.index, self.probe(k));
        if slot == 0 {
            return Option::None;
        }
        Option::Some(self.entries.at(slot - 1).value)
    }

    /// Whether `k` is in the map.
    pub fn contains(self, k: K) -> bool {
        match self.get(k) {
            Option::Some(v) => true,
            Option::None => false,
        }
    }

    /// Removes `k` and returns what it mapped to, or `None`.
    ///
    /// This rebuilds both structures, which is O(n) where the rest are O(1): a removal has
    /// to close the gap it leaves in the insertion order, and the alternative is a
    /// tombstone in every probe from then on.
    pub fn remove(self, k: K) -> Option[V] {
        if self.entries.len() == 0 {
            return Option::None;
        }
        let slot = array::at(self.index, self.probe(k));
        if slot == 0 {
            return Option::None;
        }
        let gone = self.entries.at(slot - 1).value;

        let kept = list::new[Entry[K, V]]();
        let mut i = 0;
        while i < self.entries.len() {
            if i != slot - 1 {
                kept.push(self.entries.at(i));
            }
            i = i + 1;
        }
        self.entries = kept;

        let fresh = array::new[i64](array::cap(self.index));
        let mut j = 0;
        while j < array::cap(self.index) {
            array::push(fresh, 0);
            j = j + 1;
        }
        self.index = fresh;

        let mut e = 0;
        while e < self.entries.len() {
            let at = self.probe(self.entries.at(e).key);
            array::set(self.index, at, e + 1);
            e = e + 1;
        }
        Option::Some(gone)
    }

    /// Every key, in insertion order.
    pub fn keys(self) -> List[K] {
        let out = list::new[K]();
        let mut i = 0;
        while i < self.entries.len() {
            out.push(self.entries.at(i).key);
            i = i + 1;
        }
        out
    }

    /// Every value, in insertion order.
    pub fn values(self) -> List[V] {
        let out = list::new[V]();
        let mut i = 0;
        while i < self.entries.len() {
            out.push(self.entries.at(i).value);
            i = i + 1;
        }
        out
    }

    /// Drops every entry.
    pub fn clear(self) {
        self.entries = list::new[Entry[K, V]]();
        let fresh = array::new[i64](array::cap(self.index));
        let mut i = 0;
        while i < array::cap(self.index) {
            array::push(fresh, 0);
            i = i + 1;
        }
        self.index = fresh;
    }
}

/// Walks a map's entries in insertion order.
pub struct MapIter[K, V] {
    entries: List[Entry[K, V]],
    mut i: i64,
}

impl[K, V] Iterator for MapIter[K, V] {
    type Item = Entry[K, V];
    fn next(mut self) -> Option[Entry[K, V]] {
        if self.i >= self.entries.len() {
            return Option::None;
        }
        let e = self.entries.at(self.i);
        self.i = self.i + 1;
        Option::Some(e)
    }
}

impl[K, V] IntoIterator for Map[K, V] {
    type Item = Entry[K, V];
    type Iter = MapIter[K, V];
    fn into_iter(self) -> MapIter[K, V] {
        MapIter { entries: self.entries, i: 0 }
    }
}

// --- Strings (spec/14-strings.md) --------------------------------------------------
//
// `String` is a primitive, so there is no struct to hang an inherent impl on and no way to
// write `s.len()` without a trait. `Str` is that trait: six operations the compiler
// provides, because their bodies read or allocate raw bytes, and everything else written
// here in Origin over exactly those six.
//
// The division is the same one ADR-0028 drew for collections, and the claim is the same:
// from outside, the two halves are indistinguishable. `slice` is machine code and `split`
// is the twenty lines below it, and a program cannot tell which is which.

/// Text operations on `String` (spec/14-strings.md).
///
/// Indices are **byte** indices unless a method says otherwise. Byte indexing is O(1) and
/// is what a tokenizer wants; `char_at` and `chars` are how the characters are reached. An
/// index that would split a character TRAPS rather than producing invalid UTF-8, because
/// `==`, ordering, hashing and printing all assume a `String` is valid text.
pub trait Str {
    /// The length in bytes.
    fn len(self) -> i64;

    /// The byte at `i`, in `0..=255`. TRAPS `index out of range`.
    fn byte_at(self, i: i64) -> i64;

    /// The bytes in `[start, end)`. TRAPS `index out of range`, or
    /// `string index is not a character boundary`.
    fn slice(self, start: i64, end: i64) -> String;

    /// `self` followed by `other`.
    fn concat(self, other: String) -> String;

    /// The character whose encoding starts at byte `i`. TRAPS `index out of range`, or
    /// `string index is not a character boundary`.
    fn char_at(self, i: i64) -> char;

    /// How many bytes the character at `i` occupies: 1, 2, 3 or 4. Same traps as `char_at`.
    fn char_width(self, i: i64) -> i64;

    /// Whether there are no bytes at all.
    fn is_empty(self) -> bool {
        self.len() == 0
    }

    /// `self` as a `String`.
    ///
    /// Inside a default body `self` has type `Self`, not `String`, so this is what the
    /// bodies below use wherever one is called for. For `String` itself it is a copy of
    /// the whole thing, which is what makes it total for a future implementor whose
    /// representation is not a `String` at all.
    fn as_string(self) -> String {
        self.slice(0, self.len())
    }

    /// How many characters. This is `len()` only for text that is entirely ASCII.
    fn char_count(self) -> i64 {
        let mut n = 0;
        let mut i = 0;
        while i < self.len() {
            i = i + self.char_width(i);
            n = n + 1;
        }
        n
    }

    /// Whether `self` begins with the bytes of `prefix`.
    fn starts_with(self, prefix: String) -> bool {
        self.matches_at(0, prefix)
    }

    /// Whether `self` ends with the bytes of `suffix`.
    fn ends_with(self, suffix: String) -> bool {
        if suffix.len() > self.len() {
            return false;
        }
        self.matches_at(self.len() - suffix.len(), suffix)
    }

    /// Whether `needle`'s bytes occur at byte index `at`.
    ///
    /// Comparing bytes rather than slicing is what makes this safe at any index: a slice
    /// whose end fell inside a character would TRAP, and a search has to be able to ask
    /// about a position before it knows whether the answer is yes.
    fn matches_at(self, at: i64, needle: String) -> bool {
        if at + needle.len() > self.len() {
            return false;
        }
        let mut i = 0;
        while i < needle.len() {
            if self.byte_at(at + i) != needle.byte_at(i) {
                return false;
            }
            i = i + 1;
        }
        true
    }

    /// The byte index where `needle` first occurs, or `None`.
    ///
    /// Searching by bytes gives the same answer as searching by characters: UTF-8 is
    /// self-synchronizing, so a valid encoding never occurs inside another one.
    fn find(self, needle: String) -> Option[i64] {
        if needle.len() > self.len() {
            return Option::None;
        }
        let last = self.len() - needle.len();
        let mut at = 0;
        while at <= last {
            if self.matches_at(at, needle) {
                return Option::Some(at);
            }
            at = at + 1;
        }
        Option::None
    }

    /// Whether `needle` occurs anywhere in `self`.
    fn contains(self, needle: String) -> bool {
        match self.find(needle) {
            Option::Some(_) => true,
            Option::None => false,
        }
    }

    /// The pieces between occurrences of `sep`: one more piece than separators found.
    ///
    /// An empty separator has no occurrences to find, so the whole string is one piece.
    fn split(self, sep: String) -> List[String] {
        let out = list::new[String]();
        if sep.is_empty() {
            out.push(self.as_string());
            return out;
        }
        // `at` only ever moves by a whole character or past a whole separator, so it is
        // always a character boundary and every slice below is legal. Testing for the
        // separator by bytes rather than by slicing is what makes that possible: a slice
        // at a mid-character offset would TRAP before the comparison ever happened.
        let mut start = 0;
        let mut at = 0;
        while at + sep.len() <= self.len() {
            if self.matches_at(at, sep) {
                out.push(self.slice(start, at));
                at = at + sep.len();
                start = at;
            } else {
                at = at + self.char_width(at);
            }
        }
        out.push(self.slice(start, self.len()));
        out
    }

    /// The characters, in order.
    fn chars(self) -> List[char] {
        let out = list::new[char]();
        let mut i = 0;
        while i < self.len() {
            out.push(self.char_at(i));
            i = i + self.char_width(i);
        }
        out
    }

    /// `self` joined to itself `n` times. `n <= 0` gives the empty string.
    fn repeat(self, n: i64) -> String {
        // By doubling, not by `n` concatenations. Each `concat` copies both operands, so
        // appending one piece at a time copies the whole accumulated string every time --
        // quadratic, and visibly so: a 128 KiB string took longer to build than the rest
        // of the end-to-end suite took to run. Binary exponentiation makes it O(log n)
        // concatenations of geometrically growing pieces instead.
        if n <= 0 {
            return "";
        }
        let mut out = "";
        let mut acc = self.as_string();
        let mut k = n;
        while k > 0 {
            if k - (k / 2) * 2 == 1 {
                out = out.concat(acc);
            }
            k = k / 2;
            if k > 0 {
                acc = acc.concat(acc);
            }
        }
        out
    }

    /// `self` without leading ASCII whitespace: space, tab, newline, carriage return.
    fn trim_start(self) -> String {
        let mut i = 0;
        while i < self.len() && is_ascii_space(self.byte_at(i)) {
            i = i + 1;
        }
        self.slice(i, self.len())
    }

    /// `self` without trailing ASCII whitespace.
    fn trim_end(self) -> String {
        let mut n = self.len();
        while n > 0 && is_ascii_space(self.byte_at(n - 1)) {
            n = n - 1;
        }
        self.slice(0, n)
    }

    /// `self` without whitespace at either end.
    fn trim(self) -> String {
        self.trim_start().trim_end()
    }

    /// The decimal integer `self` denotes, or `None`.
    ///
    /// An optional `-` or `+`, then one or more ASCII digits, then nothing. A value too
    /// large for an `i64` is `None` rather than a trap: overflow here is a property of the
    /// input, and `checked_mul`/`checked_add` are what keep it one.
    fn parse_int(self) -> Option[i64] {
        if self.is_empty() {
            return Option::None;
        }
        let mut i = 0;
        let mut negative = false;
        let first = self.byte_at(0);
        if first == 45 {
            negative = true;
            i = 1;
        } else {
            if first == 43 {
                i = 1;
            }
        }
        if i >= self.len() {
            return Option::None;
        }
        // Accumulating the magnitude as a negative number is what lets `i64::MIN` parse:
        // its magnitude has no positive representation, and its own negation is itself.
        let mut acc = 0;
        while i < self.len() {
            let b = self.byte_at(i);
            if b < 48 || b > 57 {
                return Option::None;
            }
            let digit = b - 48;
            match acc.checked_mul(10) {
                Option::None => { return Option::None; }
                Option::Some(scaled) => {
                    match scaled.checked_sub(digit) {
                        Option::None => { return Option::None; }
                        Option::Some(next) => { acc = next; }
                    }
                }
            }
            i = i + 1;
        }
        if negative {
            return Option::Some(acc);
        }
        // `acc` is the magnitude, accumulated negative; negating it is the only step that
        // can fail, and only for `i64::MIN`, whose magnitude has no positive value.
        0.checked_sub(acc)
    }
}

impl Str for String {
    fn len(self) -> i64 { str::len(self) }
    fn byte_at(self, i: i64) -> i64 { str::byte_at(self, i) }
    fn slice(self, start: i64, end: i64) -> String { str::slice(self, start, end) }
    fn concat(self, other: String) -> String { str::concat(self, other) }
    fn char_at(self, i: i64) -> char { str::char_at(self, i) }
    fn char_width(self, i: i64) -> i64 { str::char_width(self, i) }
}

/// Whether a byte is ASCII space, tab, newline or carriage return.
fn is_ascii_space(b: i64) -> bool {
    b == 32 || b == 9 || b == 10 || b == 13
}

// --- Files (spec/15-files.md) ------------------------------------------------------
//
// A whole file at a time, and no handle. A handle would be a resource Origin has no way to
// close automatically -- there are no destructors and no `defer`, and the collector is not
// a schedule -- so a leaked descriptor would be exactly the quiet failure this language
// exists to not have.
//
// The compiler provides four operations whose bodies are system calls. Each returns a
// status or a primitive rather than a `Result`, for the reason every other one does: the
// native backend has no way to construct a prelude type, so the `Result` is built here.

/// What went wrong with a file operation (spec/15-files.md).
///
/// Three cases, because they are the three a program acts on differently. There is no
/// errno: a number the system happened to use is not something a program should branch on.
pub enum IoError {
    NotFound,
    PermissionDenied,
    Other,
}

impl Show for IoError {
    fn to_str(self) -> String {
        match self {
            IoError::NotFound => "not found",
            IoError::PermissionDenied => "permission denied",
            IoError::Other => "I/O error",
        }
    }
}

/// The status codes `std::fs` returns, turned into the error a program matches on.
fn io_error_of(status: i64) -> IoError {
    match status {
        1 => IoError::NotFound,
        2 => IoError::PermissionDenied,
        _ => IoError::Other,
    }
}

/// Whether a run of bytes is well-formed UTF-8 (spec/14-strings.md's encoding table).
///
/// It is written here, in Origin, rather than three times over in three runtimes: the
/// answer has to be the same on every engine, and one implementation is how that is made
/// true rather than checked. Overlong encodings, surrogates and anything past U+10FFFF are
/// rejected, which is what makes "a `String` is valid UTF-8" mean something.
fn is_valid_utf8(s: String) -> bool {
    let mut i = 0;
    while i < s.len() {
        let b = s.byte_at(i);
        let mut width = 0;
        let mut lo = 0;
        let mut scalar = 0;
        if b < 128 {
            i = i + 1;
            continue;
        }
        if b >= 194 && b <= 223 {
            width = 2;
            lo = 128;
            scalar = b - 192;
        } else {
            if b >= 224 && b <= 239 {
                width = 3;
                lo = 2048;
                scalar = b - 224;
            } else {
                if b >= 240 && b <= 244 {
                    width = 4;
                    lo = 65536;
                    scalar = b - 240;
                } else {
                    return false;
                }
            }
        }
        if i + width > s.len() {
            return false;
        }
        let mut k = 1;
        while k < width {
            let c = s.byte_at(i + k);
            if c < 128 || c > 191 {
                return false;
            }
            scalar = scalar * 64 + (c - 128);
            k = k + 1;
        }
        if scalar < lo {
            return false; // an overlong encoding of something shorter
        }
        if scalar > 1114111 {
            return false;
        }
        if scalar >= 55296 && scalar <= 57343 {
            return false; // a surrogate, which is not a scalar value
        }
        i = i + width;
    }
    true
}

/// The whole file, as text.
///
/// A file whose bytes are not valid UTF-8 is `Err(Other)` rather than a `String` that
/// lies: every other part of the language assumes a `String` is valid text (spec/14).
pub fn read_to_string(path: String) -> Result[String, IoError] {
    let status = fs::read_file(path);
    if status != 0 {
        return Result::Err(io_error_of(status));
    }
    let text = fs::taken_text();
    if !is_valid_utf8(text) {
        return Result::Err(IoError::Other);
    }
    Result::Ok(text)
}

/// Writes the whole file, creating it if it does not exist and truncating it if it does.
pub fn write_string(path: String, contents: String) -> Result[(), IoError] {
    let status = fs::write_file(path, contents);
    if status != 0 {
        return Result::Err(io_error_of(status));
    }
    Result::Ok(())
}

/// Whether the path can be opened for reading. Never an error: a path that cannot be read
/// is exactly what `false` means here.
pub fn file_exists(path: String) -> bool {
    fs::file_exists(path)
}
