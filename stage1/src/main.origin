// stage1's driver: the command line of the compiler for Origin that is written in Origin.
//
// It is deliberately shaped like `cmd/originc`'s, because the two are meant to become
// interchangeable: the same subcommand names, the same exit statuses (0 succeeded, 1 the
// program was rejected, 2 the command line was wrong), and diagnostics that name a place
// the same way. What it can do is what stage1 can do -- lexing, parsing, name resolution,
// type checking and monomorphization -- either one file at a time or, with `--package`,
// a whole package the way a compiler actually compiles one. What it cannot do yet, emit
// code, it does not pretend to (process rule 8): there is no `run` and no `build`.

use std::io;
use std::list;
use std::process;
use source;
use lex;
use ast;
use parse;
use resolve;
use bytecode;
use check;
use mono;
use compile;
use irbuild;
use opt;

const USAGE: String = "usage: stage1 <command> <file>...

commands:
  dump-tokens   print the token stream
  dump-ast      print the parsed syntax tree
  parse         parse and report syntax errors only
  resolve       resolve each file after the first as its own package, with the
                first as the prelude, and print the resolution trace
  check         resolve and type-check each file after the first the same way,
                and print the inference trace
  mono          check each file after the first the same way and print the
                monomorphization trace: which copy of each generic function the
                program needs, and which copy every call site reaches
  dump-bytecode compile each file after the first the same way and print the
                bytecode, in `originc dump-bytecode`'s own format
  dump-ir       compile each file after the first the same way and print the SSA
                the bytecode builds, in `originc dump-ir`'s own format. -O0
                (the default) prints what the builder produced; -O1 and -O2 run
                the optimizer over it first

`resolve`, `check`, `mono`, `dump-bytecode` and `dump-ir` also take

  <prelude> --package <root> <file>...

which makes every file one module of a *single* package rather than a package of
its own, taking each module path from where the file sits under <root>. The files
are named rather than found because listing a directory is not written yet.

exit status:
  0    success
  1    a file was rejected
  2    the command line was wrong";

/// One lexing or parsing error, flattened so that the two lists can be reported in one
/// pass in source order.
struct Problem {
    message: String,
    start: i64,
}

fn main() {
    let raw = args();
    // `-O0`, `-O1` and `-O2` may appear anywhere, exactly as `originc dump-ir -O2 <file>`
    // takes them, and only `dump-ir` reads the answer: it is the level the optimizer runs
    // at, and every other command produces the same artefact at all three.
    let mut level = opt::O0;
    let argv = list::new[String]();
    let mut ai = 0;
    while ai < raw.len() {
        let a = raw.at(ai);
        ai = ai + 1;
        if a == "-O0" { level = opt::O0; continue; }
        if a == "-O1" { level = opt::O1; continue; }
        if a == "-O2" { level = opt::O2; continue; }
        argv.push(a);
    }
    if argv.len() < 3 {
        io::println(USAGE);
        process::exit(2);
    }
    let command = argv.at(1);
    if command != "dump-tokens" && command != "dump-ast" && command != "parse"
        && command != "resolve" && command != "check" && command != "mono"
        && command != "dump-bytecode" && command != "dump-ir" {
        io::println("stage1: unknown command `\(command)`");
        io::println(USAGE);
        process::exit(2);
    }

    // These are whole-package commands: a module cannot be resolved without the ones it
    // imports (spec/07-modules.md), nothing can be checked before it is resolved, nothing
    // can be monomorphized before it is checked, and nothing can be lowered before that.
    if command == "resolve" || command == "check" || command == "mono"
        || command == "dump-bytecode" || command == "dump-ir" {
        if !run_package(argv, command, level) {
            process::exit(1);
        }
        return;
    }

    let mut rejected = false;
    let mut i = 2;
    while i < argv.len() {
        if !run(command, argv.at(i)) {
            rejected = true;
        }
        i = i + 1;
    }
    if rejected {
        process::exit(1);
    }
}

/// The name the prelude is known by, whatever path it was read from.
///
/// It is load-bearing rather than cosmetic, which is why it is a constant here and not
/// the file's own path: the Go compiler decides "was this declared in the prelude?" by
/// comparing this exact name (its `DeclaredInPrelude`), and so must anything that means
/// to be the same compiler.
const PRELUDE_NAME: String = "<prelude>";

/// Resolves each file named after the first as its own package, with the first as the
/// prelude, and prints the resolution trace of each under a `== path` header.
///
/// One package per file rather than one package of all of them, because that is the shape
/// `originc check <file>` compiles in and the shape the differential compares: two files
/// that both declare `main` are not a package. The prelude is parsed once and shared,
/// since resolution does not write into the tree.
fn run_package(argv: List[String], command: String, level: i64) -> bool {
    let typed = typed_command(command);
    if argv.len() < 4 {
        io::println("stage1: this command takes the prelude and at least one file");
        return false;
    }
    let prelude_path = argv.at(2);
    if argv.len() > 4 && argv.at(3) == "--package" {
        if argv.len() < 6 {
            io::println("stage1: `--package` takes a source root and at least one file");
            return false;
        }
        return run_one_package(argv, command, prelude_path, level);
    }
    let mut prelude_tree = ast::File { uses: list::new[ast::Use](), items: list::new[ast::Item]() };
    match read_to_string(prelude_path) {
        Result::Err(e) => {
            io::println("stage1: cannot read \(prelude_path): \(e.to_str())");
            return false;
        }
        Result::Ok(src) => {
            prelude_tree = parse::parse(lex::lex(src).tokens).file;
        }
    }

    let mut ok = true;
    let mut i = 3;
    while i < argv.len() {
        let path = argv.at(i);
        match read_to_string(path) {
            Result::Err(e) => {
                io::println("stage1: cannot read \(path): \(e.to_str())");
                ok = false;
            }
            Result::Ok(src) => {
                io::println("== \(path)");
                let lexed = lex::lex(src);
                let parsed = parse::parse(lexed.tokens);
                let tree = parsed.file;
                // A file whose syntax is wrong has error nodes in its tree, and there is
                // no code to generate from one. The passes before code generation are
                // deliberately run over the recovered tree -- that is what makes their
                // differentials demanding -- but lowering it would only ask both compilers
                // to refuse, which is what `originc` does by stopping here
                // (spec/09-errors.md). Both halves of syntax count: a bad escape is the
                // lexer's diagnostic, and it leaves a tree just as unusable.
                if lowered_command(command)
                    && (!lexed.errors.is_empty() || !parsed.errors.is_empty()) {
                    i = i + 1;
                    continue;
                }
                let inputs = list::new[resolve::Input]();
                inputs.push(resolve::Input {
                    file: PRELUDE_NAME, module: "", tree: prelude_tree, prelude: true,
                });
                inputs.push(resolve::Input {
                    file: path, module: "", tree: tree, prelude: false,
                });
                let resolved = resolve::program(inputs);
                // The resolution trace is `resolve`'s output; `check`'s is the inference
                // trace, and printing both would be two answers to one question.
                if !report_resolution(resolved, command == "resolve") {
                    ok = false;
                } else {
                    if typed {
                        let units = list::new[check::Unit]();
                        units.push(check::Unit { file: PRELUDE_NAME, tree: prelude_tree });
                        units.push(check::Unit { file: path, tree: tree });
                        let checked = check::program(resolved, units);
                        if !report_check(checked, command) {
                            ok = false;
                        } else {
                            if mono_command(command) {
                                // Monomorphization runs as part of deciding a program's
                                // legality (ADR-0010): a polymorphic-recursion chain past
                                // the depth limit is E0055, and `check` must reach the same
                                // verdict as `run`.
                                let munits = list::new[mono::Unit]();
                                munits.push(mono::Unit {
                                    file: PRELUDE_NAME, tree: prelude_tree,
                                });
                                munits.push(mono::Unit { file: path, tree: tree });
                                let mo = mono::program(checked, munits);
                                if !report_mono(mo, command == "mono") {
                                    ok = false;
                                } else {
                                    if lowered_command(command) {
                                        let cunits = list::new[compile::Unit]();
                                        cunits.push(compile::Unit {
                                            file: PRELUDE_NAME, tree: prelude_tree,
                                        });
                                        cunits.push(compile::Unit { file: path, tree: tree });
                                        if !report_lowered(
                                                compile::program(resolved, checked, mo, cunits),
                                                command, level) {
                                            ok = false;
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        i = i + 1;
    }
    ok
}

// --- One package of many files -----------------------------------------------------------
//
// The shape a compiler actually compiles in, and the shape stage1 has to reach to compile
// itself: every file after the source root is one module of a single package, its module
// path taken from where it sits under that root (spec/07-modules.md -- the filesystem is
// the module tree). The root is passed rather than discovered because listing a directory
// is Phase 10 (docs/deferred.md); the caller already knows every file it wants.

fn run_one_package(argv: List[String], command: String, prelude_path: String, level: i64) -> bool {
    let root = argv.at(4);
    let mut prelude_tree = ast::File { uses: list::new[ast::Use](), items: list::new[ast::Item]() };
    match read_to_string(prelude_path) {
        Result::Err(e) => {
            io::println("stage1: cannot read \(prelude_path): \(e.to_str())");
            return false;
        }
        Result::Ok(src) => {
            prelude_tree = parse::parse(lex::lex(src).tokens).file;
        }
    }

    let paths = list::new[String]();
    let modules = list::new[String]();
    let mut i = 5;
    while i < argv.len() {
        paths.push(argv.at(i));
        modules.push(module_path(argv.at(i), root));
        i = i + 1;
    }
    // The root module first, then the rest by module path, so that the unit order does not
    // depend on the order the command line happened to list them in.
    sort_units(paths, modules);

    io::println("== \(root)");
    let trees = list::new[ast::File]();
    let inputs = list::new[resolve::Input]();
    inputs.push(resolve::Input {
        file: PRELUDE_NAME, module: "", tree: prelude_tree, prelude: true,
    });
    let mut u = 0;
    while u < paths.len() {
        match read_to_string(paths.at(u)) {
            Result::Err(e) => {
                io::println("stage1: cannot read \(paths.at(u)): \(e.to_str())");
                return false;
            }
            Result::Ok(src) => {
                let lexed = lex::lex(src);
                let parsed = parse::parse(lexed.tokens);
                if lowered_command(command)
                    && (!lexed.errors.is_empty() || !parsed.errors.is_empty()) {
                    io::println("stage1: \(paths.at(u)) does not parse");
                    return false;
                }
                let tree = parsed.file;
                trees.push(tree);
                inputs.push(resolve::Input {
                    file: paths.at(u), module: modules.at(u), tree: tree, prelude: false,
                });
            }
        }
        u = u + 1;
    }

    let resolved = resolve::program(inputs);
    if !report_resolution(resolved, command == "resolve") {
        return false;
    }
    if !typed_command(command) {
        return true;
    }
    let units = list::new[check::Unit]();
    units.push(check::Unit { file: PRELUDE_NAME, tree: prelude_tree });
    let mut k = 0;
    while k < trees.len() {
        units.push(check::Unit { file: paths.at(k), tree: trees.at(k) });
        k = k + 1;
    }
    let checked = check::program(resolved, units);
    if !report_check(checked, command) {
        return false;
    }
    if !mono_command(command) {
        return true;
    }
    let munits = list::new[mono::Unit]();
    munits.push(mono::Unit { file: PRELUDE_NAME, tree: prelude_tree });
    let mut m = 0;
    while m < trees.len() {
        munits.push(mono::Unit { file: paths.at(m), tree: trees.at(m) });
        m = m + 1;
    }
    let mo = mono::program(checked, munits);
    if !report_mono(mo, command == "mono") {
        return false;
    }
    if !lowered_command(command) {
        return true;
    }
    let cunits = list::new[compile::Unit]();
    cunits.push(compile::Unit { file: PRELUDE_NAME, tree: prelude_tree });
    let mut b = 0;
    while b < trees.len() {
        cunits.push(compile::Unit { file: paths.at(b), tree: trees.at(b) });
        b = b + 1;
    }
    report_lowered(compile::program(resolved, checked, mo, cunits), command, level)
}

fn typed_command(command: String) -> bool {
    command == "check" || mono_command(command)
}

/// Whether a command needs the instantiation set.
fn mono_command(command: String) -> bool {
    command == "mono" || lowered_command(command)
}

/// Whether a command needs the bytecode.
fn lowered_command(command: String) -> bool {
    command == "dump-bytecode" || command == "dump-ir"
}

/// A path under the source root becomes a module path: `resolve.origin` is `resolve`,
/// `a/b.origin` is `a::b`, and `main.origin` or `lib.origin` at the root is the root
/// module itself.
fn module_path(path: String, root: String) -> String {
    let mut rel = path;
    if root != "" && rel.starts_with(root) {
        rel = rel.slice(root.len(), rel.len());
    }
    while rel.starts_with("/") {
        rel = rel.slice(1, rel.len());
    }
    if rel.ends_with(".origin") {
        rel = rel.slice(0, rel.len() - 7);
    }
    if rel == "main" || rel == "lib" {
        return "";
    }
    replace_all(rel, "/", "::")
}

fn replace_all(s: String, from: String, to: String) -> String {
    let mut out = "";
    let mut i = 0;
    while i < s.len() {
        if i + from.len() <= s.len() && s.slice(i, i + from.len()) == from {
            out = "\(out)\(to)";
            i = i + from.len();
        } else {
            out = "\(out)\(s.slice(i, i + 1))";
            i = i + 1;
        }
    }
    out
}

/// Sorts the units the way `internal/driver` does: the root module first, then by module
/// path. Both lists are permuted together, since a unit is a path and a module path.
fn sort_units(paths: List[String], modules: List[String]) {
    let mut i = 1;
    while i < modules.len() {
        let pm = modules.at(i);
        let pp = paths.at(i);
        let mut j = i;
        while j > 0 && unit_before(pm, modules.at(j - 1)) {
            modules.set(j, modules.at(j - 1));
            paths.set(j, paths.at(j - 1));
            j = j - 1;
        }
        modules.set(j, pm);
        paths.set(j, pp);
        i = i + 1;
    }
}

fn unit_before(a: String, b: String) -> bool {
    if (a == "") != (b == "") {
        return a == "";
    }
    str_less(a, b)
}

/// Compares two strings the way Go's `<` does: byte by byte, and on a shared prefix
/// the shorter one first.
fn str_less(a: String, b: String) -> bool {
    let mut i = 0;
    while i < a.len() && i < b.len() {
        let x = a.byte_at(i);
        let y = b.byte_at(i);
        if x != y {
            return x < y;
        }
        i = i + 1;
    }
    a.len() < b.len()
}

/// True when `a` belongs strictly before `b` in `diag.Bag.All`'s order: file name,
/// then start offset, then end offset. Diagnostics come out of a compiler in whatever
/// order its passes happened to discover problems in, and rule 6 requires the output
/// not to depend on that.
fn before(a_file: String, a_start: i64, a_end: i64, b_file: String, b_start: i64, b_end: i64) -> bool {
    if a_file != b_file {
        return str_less(a_file, b_file);
    }
    if a_start != b_start {
        return a_start < b_start;
    }
    a_end < b_end
}

/// A stable insertion sort, which is what `sort.SliceStable` gives the Go driver:
/// entries that compare equal keep the order the passes emitted them in.
fn sort_by[T](xs: List[T], less: fn(T, T) -> bool) {
    let mut i = 1;
    while i < xs.len() {
        let cur = xs.at(i);
        let mut j = i;
        while j > 0 && less(cur, xs.at(j - 1)) {
            xs.set(j, xs.at(j - 1));
            j = j - 1;
        }
        xs.set(j, cur);
        i = i + 1;
    }
}

fn report_check(out: check::Checked, command: String) -> bool {
    // Everything but `dump-bytecode` writes diagnostics and nothing else, so a warning
    // belongs in the output. `dump-bytecode`'s output is the artefact, and a warning is
    // not part of it: `originc` makes the same split by writing every diagnostic to
    // stderr and the bytecode to stdout, and stage1 has only one stream to write to.
    let artefact = lowered_command(command);
    let with_trace = command == "check";
    let errors = out.errors;
    sort_by(errors, |a, b| before(a.file, a.start, a.end, b.file, b.start, b.end));
    let mut e = 0;
    while e < errors.len() {
        let err = errors.at(e);
        if !artefact || !err.warning {
            io::println("error \(err.code) \(err.file):\(err.start):\(err.end): \(err.message)");
        }
        e = e + 1;
    }
    if with_trace {
        let mut t = 0;
        while t < out.trace.len() {
            io::println(out.trace.at(t));
            t = t + 1;
        }
    }
    // A warning is printed and then stepped over: the program compiles, the passes after
    // this one run, and the exit status is success. Counting diagnostics rather than
    // errors here made `stage1 check` reject a program `originc check` accepts.
    !any_error(errors)
}

/// Whether any of these diagnostics stops compilation.
fn any_error(errors: List[check::CheckError]) -> bool {
    let mut i = 0;
    while i < errors.len() {
        if !errors.at(i).warning {
            return true;
        }
        i = i + 1;
    }
    false
}

fn report_mono(out: mono::Result, with_trace: bool) -> bool {
    let errors = out.errors;
    sort_by(errors, |a, b| before(a.file, a.start, a.end, b.file, b.start, b.end));
    let mut e = 0;
    while e < errors.len() {
        let err = errors.at(e);
        io::println("error \(err.code) \(err.file):\(err.start):\(err.end): \(err.message)");
        e = e + 1;
    }
    if with_trace {
        let mut t = 0;
        while t < out.trace.len() {
            io::println(out.trace.at(t));
            t = t + 1;
        }
    }
    out.errors.is_empty()
}

/// Prints the artefact a lowering command asks for -- the disassembled bytecode, or the
/// SSA that bytecode builds -- in `originc`'s own format, so that the two compilers'
/// output is comparable directly rather than through a trace invented for the purpose.
fn report_lowered(out: compile::Lowered, command: String, level: i64) -> bool {
    if !out.errors.is_empty() {
        let mut e = 0;
        while e < out.errors.len() {
            let err = out.errors.at(e);
            io::println("stage1: \(err.message) at \(err.file):\(err.start):\(err.end)");
            e = e + 1;
        }
        return false;
    }
    // A package with no `main` is a library: nothing was lowered and nothing is wrong.
    // `originc` puts nothing on stdout for one either.
    if !out.has_entry {
        return true;
    }
    if command == "dump-ir" {
        return report_ir(out.prog, level);
    }
    let parts = out.prog.disassemble();
    let mut i = 0;
    while i < parts.len() {
        io::print(parts.at(i));
        i = i + 1;
    }
    true
}

/// Prints every function's SSA, which is what `originc dump-ir -O0` prints: the IR the
/// bytecode builds, before any optimizer has touched it.
fn report_ir(prog: bytecode::Program, level: i64) -> bool {
    if level == opt::O0 {
        return report_unoptimized_ir(prog);
    }
    let built = opt::dump(prog, level);
    if built.error != "" {
        io::println("stage1: \(built.error)");
        return false;
    }
    let mut i = 0;
    while i < built.funcs.len() {
        match built.funcs.at(i) {
            Option::Some(f) => {
                let parts = f.print(prog);
                let mut k = 0;
                while k < parts.len() {
                    io::print(parts.at(k));
                    k = k + 1;
                }
                io::print("\n");
            },
            Option::None => {},
        }
        i = i + 1;
    }
    true
}

fn report_resolution(out: resolve::Resolved, with_trace: bool) -> bool {
    let errors = out.errors;
    sort_by(errors, |a, b| before(a.file, a.start, a.end, b.file, b.start, b.end));
    let mut e = 0;
    while e < errors.len() {
        let err = errors.at(e);
        io::println("error \(err.code) \(err.file):\(err.start):\(err.end): \(err.message)");
        e = e + 1;
    }
    if with_trace {
        let mut t = 0;
        while t < out.trace.len() {
            io::println(out.trace.at(t));
            t = t + 1;
        }
    }
    out.errors.is_empty()
}

/// Runs one file, reporting whether it was accepted.
fn run(command: String, path: String) -> bool {
    match read_to_string(path) {
        Result::Err(e) => {
            io::println("stage1: cannot read \(path): \(e.to_str())");
            false
        }
        Result::Ok(src) => {
            let f = source::file(path, src);
            let lexed = lex::lex(src);
            let parsed = parse::parse(lexed.tokens);

            let problems = list::new[Problem]();
            let mut i = 0;
            while i < lexed.errors.len() {
                let e = lexed.errors.at(i);
                problems.push(Problem { message: e.message, start: e.start });
                i = i + 1;
            }
            let mut j = 0;
            while j < parsed.errors.len() {
                let e = parsed.errors.at(j);
                problems.push(Problem { message: e.message, start: e.start });
                j = j + 1;
            }
            sort_problems(problems);

            let mut k = 0;
            while k < problems.len() {
                let p = problems.at(k);
                io::println("\(f.locate(p.start)): \(p.message)");
                k = k + 1;
            }
            if problems.len() > 0 {
                // A tree recovered from a broken file is still printed: recovery is
                // normative (spec/02-grammar.md), and what it produced is exactly what a
                // reader of this output needs to see.
                report(command, f, lexed, parsed);
                return false;
            }
            report(command, f, lexed, parsed);
            true
        }
    }
}

fn report(command: String, f: source::File, lexed: lex::Lexed, parsed: parse::Parsed) {
    if command == "dump-tokens" {
        dump_tokens(f, lexed.tokens);
    } else {
        if command == "dump-ast" {
            let lines = ast::dump(parsed.file);
            let mut i = 0;
            while i < lines.len() {
                io::println(lines.at(i));
                i = i + 1;
            }
        }
    }
}

/// One line per token: where it starts, what it is, and its text.
fn dump_tokens(f: source::File, toks: List[lex::Token]) {
    let mut i = 0;
    while i < toks.len() {
        let t = toks.at(i);
        let p = f.position(t.start);
        io::println("\(p.line):\(p.col) \(lex::kind_name(t.kind)) \(t.text)");
        i = i + 1;
    }
}

/// Insertion sort by starting offset, which keeps a lexer's errors and a parser's
/// interleaved in the order a reader meets them. The list is short by construction --
/// a file with hundreds of errors has one real error and a lot of recovery.
fn sort_problems(ps: List[Problem]) {
    let mut i = 1;
    while i < ps.len() {
        let mut j = i;
        while j > 0 && ps.at(j - 1).start > ps.at(j).start {
            let a = ps.at(j - 1);
            ps.set(j - 1, ps.at(j));
            ps.set(j, a);
            j = j - 1;
        }
        i = i + 1;
    }
}

/// `-O0`: build each function's SSA, print it, and let it go.
///
/// One at a time rather than all of them, which is what `opt::dump` does and has to do:
/// the optimizer's own pipeline reads a callee's IR while rewriting its caller. Holding
/// every function of a program the size of this compiler is worth a hundred megabytes of
/// heap, and at `-O0` nothing needs it.
fn report_unoptimized_ir(prog: bytecode::Program) -> bool {
    let mut i = 0;
    while i < prog.fns.len() {
        let f = prog.fns.at(i);
        if !f.code.is_empty() {
            let built = irbuild::build(f);
            if built.error != "" {
                io::println("stage1: building \(f.name): \(built.error)");
                return false;
            }
            let parts = built.f.print(prog);
            let mut k = 0;
            while k < parts.len() {
                io::print(parts.at(k));
                k = k + 1;
            }
            io::print("\n");
        }
        i = i + 1;
    }
    true
}
