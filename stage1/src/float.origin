// Float remainder, in machine code (spec/04-expressions.md).
//
// A translation of `internal/backend/float.go`.
//
// SSE has no remainder instruction. x87's `fprem` is the only hardware form, and pulling the
// x87 stack in for one operation was not worth it in Phase 5 -- so `%` on floats worked on the
// interpreter and the virtual machine and failed to build natively, loudly, for four phases
// (docs/deferred.md).
//
// What closes it is not `fprem` and not Frexp/Ldexp, but the observation that the remainder is
// *unique*: for finite x and non-zero y there is exactly one r with |r| < |y|, sign(r) =
// sign(x) and x - r a multiple of y. Any exact algorithm therefore agrees with the other two
// engines bit for bit, and repeated halving is exact:
//
//     a, d = |x|, |y|
//     scaled = d;  while scaled*2 <= a { scaled = scaled * 2 }
//     while scaled >= d { if a >= scaled { a = a - scaled }; scaled = scaled / 2 }
//
// Every doubling and every halving is a change to the exponent alone, so no bit of the
// significand is ever rounded away -- including when d is subnormal, where halving retraces
// exactly the values doubling produced. `scaled * 2` overflowing to +Inf ends the first loop
// rather than misbehaving, since `Inf <= a` is false for finite a.
//
// The optimizer's own constant folder has been running this algorithm in Origin since
// `opt.origin` was written, held to the Go one by the `-O2` differential.

use emitter;
use regalloc;
use runtime;
use x86;

/// The quiet NaN the other two engines produce for an undefined remainder. `float::bits` can see
/// which NaN a program got, so native code produces the same one.
const NAN_BITS: u64 = 9221120237041090561u64;

/// 2.0.
const TWO_BITS: u64 = 4611686018427387904u64;

/// Every bit but the sign.
const NOT_SIGN_BIT: u64 = 9223372036854775807u64;

/// The sign bit alone.
const SIGN_BIT: u64 = 9223372036854775808u64;

/// The pattern of positive infinity: anything at or above it is Inf or NaN.
const INF_BITS: i64 = 9218868437227405312;

/// Writes `rt_float_mod(x rdi, y rsi) -> rax`, all three raw f64 bits.
///
/// A leaf: it calls nothing, allocates nothing and touches only scratch, so `%` on floats costs
/// a call and no safepoint.
pub fn emit_float_mod(e: emitter::Emitter) {
    let a = e.a;
    a.align(16);
    a.bind(e.rt.float_mod);

    let ret_nan = a.new_label("fmod_nan");
    let ret_x = a.new_label("fmod_x");
    let scale_up = a.new_label("fmod_scale_up");
    let scaled = a.new_label("fmod_scaled");
    let reduce = a.new_label("fmod_reduce");
    let skip = a.new_label("fmod_skip");
    let done = a.new_label("fmod_done");

    // |x| and |y|, as bit patterns. A magnitude comparison on the bits is the same ordering as
    // on the values for non-negative finite floats, which is what makes the three
    // classification tests below plain integer compares.
    a.mov_ri(x86::RAX, NOT_SIGN_BIT);
    a.mov_rr(regalloc::SCRATCH_A, x86::RDI);
    a.and_rr(regalloc::SCRATCH_A, x86::RAX); // |x|
    a.mov_rr(regalloc::SCRATCH_B, x86::RSI);
    a.and_rr(regalloc::SCRATCH_B, x86::RAX); // |y|

    // Anything at or above the infinity pattern is Inf or NaN.
    a.mov_ri(x86::RCX, INF_BITS as u64);
    a.cmp_rr(regalloc::SCRATCH_A, x86::RCX);
    a.jcc(x86::ABOVE_EQUAL, ret_nan); // x is Inf or NaN
    a.cmp_rr(regalloc::SCRATCH_B, x86::RCX);
    a.jcc(x86::ABOVE, ret_nan); // y is NaN
    a.jcc(x86::EQUAL, ret_x);   // y is Inf: every finite x is its own remainder
    a.test_rr(regalloc::SCRATCH_B, regalloc::SCRATCH_B);
    a.jcc(x86::EQUAL, ret_nan); // y is zero
    a.cmp_rr(regalloc::SCRATCH_A, regalloc::SCRATCH_B);
    a.jcc(x86::BELOW, ret_x); // |x| < |y|: x is its own remainder, sign and all

    a.movq_xr(x86::XMM0, regalloc::SCRATCH_A); // a = |x|
    a.movq_xr(x86::XMM1, regalloc::SCRATCH_B); // d = |y|
    a.movsd_xx(x86::XMM2, x86::XMM1);
    a.mov_ri(x86::RCX, TWO_BITS);
    a.movq_xr(x86::XMM3, x86::RCX);

    // The largest d*2^k that is no greater than a.
    a.bind(scale_up);
    a.movsd_xx(x86::XMM4, x86::XMM2);
    a.mulsd_xx(x86::XMM4, x86::XMM3);
    a.ucomisd_xx(x86::XMM4, x86::XMM0);
    a.jcc(x86::ABOVE, scaled);
    a.movsd_xx(x86::XMM2, x86::XMM4);
    a.jmp(scale_up);
    a.bind(scaled);

    // Then back down, subtracting where it fits. Neither operand can be NaN here, so the
    // unordered case `ucomisd` would signal with the parity flag cannot arise.
    a.bind(reduce);
    a.ucomisd_xx(x86::XMM2, x86::XMM1);
    a.jcc(x86::BELOW, done);
    a.ucomisd_xx(x86::XMM0, x86::XMM2);
    a.jcc(x86::BELOW, skip);
    a.subsd_xx(x86::XMM0, x86::XMM2);
    a.bind(skip);
    a.divsd_xx(x86::XMM2, x86::XMM3);
    a.jmp(reduce);

    a.bind(done);
    // The remainder takes x's sign, which is what makes `a == (a/b)*b + (a%b)` hold. `a` is
    // non-negative, so its own sign bit is clear and an OR is enough.
    a.movq_rx(x86::RAX, x86::XMM0);
    a.mov_ri(x86::RCX, SIGN_BIT);
    a.and_rr(x86::RCX, x86::RDI);
    a.or_rr(x86::RAX, x86::RCX);
    a.ret();

    a.bind(ret_x);
    a.mov_rr(x86::RAX, x86::RDI);
    a.ret();

    a.bind(ret_nan);
    a.mov_ri(x86::RAX, NAN_BITS);
    a.ret();
}
