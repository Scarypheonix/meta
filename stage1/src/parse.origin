// The Origin parser, in Origin (spec/02-grammar.md).
//
// A translation of `internal/parse`, held to it: tests/selfhost runs both over every
// `.origin` file in this repository and requires the dumped syntax trees to be identical.
// That includes the files with deliberate syntax errors in `tests/conformance`, so the
// recovery strategy §02 calls normative is translated too, not only the grammar.
//
// String interpolation is desugared here, as it is there: `"a \(x) b"` becomes
// `"a ".concat(x.to_str()).concat(" b")`, so nothing downstream learns a new form
// (spec/14-strings.md).

use std::list;
use ast;
use lex;

pub struct ParseError {
    pub message: String,
    pub start: i64,
    pub end: i64,
}

pub struct Parsed {
    pub file: ast::File,
    pub errors: List[ParseError],
}

pub struct Parser {
    toks: List[lex::Token],
    mut pos: i64,
    /// True in condition position, where a top-level struct literal would be ambiguous
    /// with the block that follows (spec/02-grammar.md's first parser restriction).
    mut no_struct: bool,
    /// Set on an error and cleared by the next token consumed, so one mistake produces one
    /// diagnostic rather than a cascade.
    mut recovering: bool,
    errors: List[ParseError],
}

/// Parses a whole file's tokens.
pub fn parse(toks: List[lex::Token]) -> Parsed {
    let p = Parser {
        toks: toks, pos: 0, no_struct: false, recovering: false,
        errors: list::new[ParseError](),
    };
    let f = p.file();
    Parsed { file: f, errors: p.errors }
}

// --- Token helpers -------------------------------------------------------------------

impl Parser {
    fn cur(self) -> lex::Token {
        self.toks.at(self.pos)
    }

    fn at(self, k: i64) -> bool {
        self.toks.at(self.pos).kind == k
    }

    fn at_eof(self) -> bool {
        self.toks.at(self.pos).kind == lex::K_EOF
    }

    /// Where the token before the cursor ended, which is where the construct just parsed
    /// ends. At the very start there is nothing behind, so the cursor's own start serves.
    fn prev_end(self) -> i64 {
        if self.pos == 0 {
            return self.toks.at(0).start;
        }
        self.toks.at(self.pos - 1).end
    }

    /// The span of everything from token `start` to the last one consumed, which is what
    /// `internal/parse`'s own `base` computes and has to stay identical to: a diagnostic
    /// that is right about the problem and wrong about the place is still wrong.
    fn span_from(self, start: i64) -> ast::Span {
        let mut end = self.pos - 1;
        if end < start {
            end = start;
        }
        if end >= self.toks.len() {
            end = self.toks.len() - 1;
        }
        ast::Span { start: self.toks.at(start).start, end: self.toks.at(end).end }
    }

    fn mk_expr(self, start: i64, node: ast::ExprKind) -> ast::Expr {
        ast::expr(self.span_from(start), node)
    }

    fn mk_pat(self, start: i64, node: ast::PatKind) -> ast::Pat {
        ast::pat(self.span_from(start), node)
    }

    fn mk_type(self, start: i64, node: ast::TypeKind) -> ast::Type {
        ast::ty(self.span_from(start), node)
    }

    fn peek_is(self, n: i64, k: i64) -> bool {
        if self.pos + n >= self.toks.len() {
            return false;
        }
        self.toks.at(self.pos + n).kind == k
    }

    fn advance(self) -> lex::Token {
        let t = self.toks.at(self.pos);
        if !self.at_eof() {
            self.pos = self.pos + 1;
            self.recovering = false;
        }
        t
    }

    fn eat(self, k: i64) -> bool {
        if self.at(k) {
            self.advance();
            return true;
        }
        false
    }

    fn expect(self, k: i64) -> bool {
        if self.at(k) {
            self.advance();
            return true;
        }
        self.error_expected(lex::kind_name(k));
        false
    }

    fn error_expected(self, what: String) {
        if self.recovering {
            return;
        }
        self.recovering = true;
        let t = self.cur();
        self.errors.push(ParseError {
            message: "expected \(what), found \(lex::token_name(t))",
            start: t.start, end: t.end,
        })
    }

    fn error_at(self, start: i64, end: i64, message: String) {
        self.recovering = true;
        self.errors.push(ParseError { message: message, start: start, end: end })
    }
}

// --- Recovery ------------------------------------------------------------------------

fn is_item_start(k: i64) -> bool {
    k == lex::K_PUB || k == lex::K_FN || k == lex::K_STRUCT || k == lex::K_ENUM
        || k == lex::K_TRAIT || k == lex::K_IMPL || k == lex::K_TYPE || k == lex::K_CONST
        || k == lex::K_USE
}

impl Parser {
    /// Skips to the next item boundary at brace depth zero.
    fn sync_item(self) {
        let mut depth = 0;
        while !self.at_eof() {
            let k = self.cur().kind;
            if k == lex::K_LBRACE {
                depth = depth + 1;
            } else {
                if k == lex::K_RBRACE {
                    if depth == 0 {
                        return;
                    }
                    depth = depth - 1;
                } else {
                    if depth == 0 && is_item_start(k) {
                        return;
                    }
                }
            }
            self.advance();
        }
    }

    /// Skips to the end of the current statement: a `;`, consumed, or a `}`, left in
    /// place for the block to close on.
    fn sync_stmt(self) {
        let mut depth = 0;
        while !self.at_eof() {
            let k = self.cur().kind;
            if k == lex::K_LBRACE || k == lex::K_LPAREN || k == lex::K_LBRACKET {
                depth = depth + 1;
            } else {
                if k == lex::K_RPAREN || k == lex::K_RBRACKET {
                    if depth > 0 {
                        depth = depth - 1;
                    }
                } else {
                    if k == lex::K_RBRACE {
                        if depth == 0 {
                            return;
                        }
                        depth = depth - 1;
                    } else {
                        if k == lex::K_SEMI && depth == 0 {
                            self.advance();
                            return;
                        }
                        if depth == 0 && is_item_start(k) {
                            return;
                        }
                    }
                }
            }
            self.advance();
        }
    }

    /// Skips to the next `,`, left in place, or the closing delimiter, never past it.
    fn sync_list(self, closer: i64) {
        let mut depth = 0;
        while !self.at_eof() {
            let k = self.cur().kind;
            if depth == 0 && (k == lex::K_COMMA || k == closer) {
                return;
            }
            if k == lex::K_LPAREN || k == lex::K_LBRACKET || k == lex::K_LBRACE {
                depth = depth + 1;
            } else {
                if k == lex::K_RPAREN || k == lex::K_RBRACKET || k == lex::K_RBRACE {
                    if depth == 0 {
                        return;
                    }
                    depth = depth - 1;
                }
            }
            self.advance();
        }
    }
}

// --- File and items ------------------------------------------------------------------

impl Parser {
    fn file(self) -> ast::File {
        let uses = list::new[ast::Use]();
        let items = list::new[ast::Item]();
        while self.at(lex::K_USE) {
            uses.push(self.use_decl());
        }
        while !self.at_eof() {
            if self.at(lex::K_USE) {
                let t = self.cur();
                let u = self.use_decl();
                self.error_at(t.start, t.end, "`use` declarations must come before all items");
                uses.push(u);
            } else {
                let before = self.pos;
                items.push(self.item());
                if self.pos == before {
                    self.advance();
                }
            }
        }
        ast::File { uses: uses, items: items }
    }

    fn use_decl(self) -> ast::Use {
        self.advance();
        let path = self.path();
        let names = list::new[ast::Ident]();
        if self.at(lex::K_COLONCOLON) && self.peek_is(1, lex::K_LBRACE) {
            self.advance();
            self.advance();
            while !self.at(lex::K_RBRACE) && !self.at_eof() {
                match self.ident() {
                    Option::Some(n) => { names.push(n); }
                    Option::None => { self.sync_list(lex::K_RBRACE); }
                }
                if !self.eat(lex::K_COMMA) {
                    break;
                }
            }
            self.expect(lex::K_RBRACE);
        }
        self.expect(lex::K_SEMI);
        ast::Use { path: path, names: names }
    }

    fn ident(self) -> Option[ast::Ident] {
        if self.at(lex::K_IDENT) {
            let t = self.advance();
            return Option::Some(ast::Ident { name: t.text, start: t.start, end: t.end, res: ast::UNRESOLVED });
        }
        self.error_expected("an identifier");
        Option::None
    }

    /// The identifier a declaration is named by, or an empty one at the current token so
    /// that a span is always available to report against.
    fn decl_name(self) -> ast::Ident {
        match self.ident() {
            Option::Some(id) => id,
            Option::None => {
                let t = self.cur();
                ast::Ident { name: "", start: t.start, end: t.end, res: ast::UNRESOLVED }
            }
        }
    }

    /// A `::`-separated path: the text the dumper prints, the span of the whole, and the
    /// span of each segment, because a diagnostic about `std::io::nope` underlines the
    /// last segment and not the path.
    fn path(self) -> ast::PathRef {
        let segs = list::new[ast::Ident]();
        let start = self.cur().start;
        let mut end = start;
        let mut text = "";
        let mut going = true;
        while going {
            if self.at(lex::K_IDENT) || self.at(lex::K_SELF_TYPE) {
                let t = self.advance();
                let name = if t.kind == lex::K_SELF_TYPE { "Self" } else { t.text };
                if !segs.is_empty() {
                    text = text.concat("::");
                }
                text = text.concat(name);
                segs.push(ast::Ident { name: name, start: t.start, end: t.end, res: ast::UNRESOLVED });
                end = t.end;
            } else {
                if segs.is_empty() {
                    self.error_expected("a path");
                    return ast::PathRef { text: text, start: start, end: start, segs: segs, res: ast::UNRESOLVED };
                }
            }
            // A `::` before `{` belongs to a braced `use` list, not to the path.
            if self.at(lex::K_COLONCOLON) && !self.peek_is(1, lex::K_LBRACE) {
                self.advance();
            } else {
                going = false;
            }
        }
        ast::PathRef { text: text, start: start, end: end, segs: segs, res: ast::UNRESOLVED }
    }

    fn item(self) -> ast::Item {
        let start = self.pos;
        let public = self.eat(lex::K_PUB);
        let k = self.cur().kind;
        if k == lex::K_FN { return ast::Item::Fn(self.fn_decl(public)); }
        if k == lex::K_STRUCT { return ast::Item::Struct(self.struct_decl(public)); }
        if k == lex::K_ENUM { return ast::Item::Enum(self.enum_decl(public)); }
        if k == lex::K_TRAIT { return ast::Item::Trait(self.trait_decl(public)); }
        if k == lex::K_IMPL {
            if public {
                let t = self.toks.at(start);
                self.error_at(t.start, t.end, "`impl` blocks cannot be `pub`");
            }
            return ast::Item::Impl(self.impl_decl());
        }
        if k == lex::K_TYPE { return ast::Item::Alias(self.alias_decl(public)); }
        if k == lex::K_CONST { return ast::Item::Const(self.const_decl(public)); }
        self.error_expected("an item (`fn`, `struct`, `enum`, `trait`, `impl`, `type` or `const`)");
        self.sync_item();
        ast::Item::ErrorItem
    }

    fn generics(self) -> List[ast::GenericParam] {
        let out = list::new[ast::GenericParam]();
        if !self.at(lex::K_LBRACKET) {
            return out;
        }
        self.advance();
        while !self.at(lex::K_RBRACKET) && !self.at_eof() {
            match self.ident() {
                Option::None => {
                    self.sync_list(lex::K_RBRACKET);
                    if !self.eat(lex::K_COMMA) {
                        return self.finish_generics(out);
                    }
                }
                Option::Some(name) => {
                    let mut bounds = list::new[ast::TraitRef]();
                    if self.eat(lex::K_COLON) {
                        bounds = self.trait_bounds();
                    }
                    out.push(ast::GenericParam { name: name, bounds: bounds });
                    if !self.eat(lex::K_COMMA) {
                        return self.finish_generics(out);
                    }
                }
            }
        }
        self.finish_generics(out)
    }

    fn finish_generics(self, out: List[ast::GenericParam]) -> List[ast::GenericParam] {
        self.expect(lex::K_RBRACKET);
        out
    }

    /// One or more trait references joined by `+`.
    fn trait_bounds(self) -> List[ast::TraitRef] {
        let out = list::new[ast::TraitRef]();
        let mut going = true;
        while going {
            let path = self.path();
            let args = self.type_args();
            out.push(ast::TraitRef { path: path, args: args });
            going = self.eat(lex::K_PLUS);
        }
        out
    }

    fn type_args(self) -> List[ast::Type] {
        let out = list::new[ast::Type]();
        if !self.at(lex::K_LBRACKET) {
            return out;
        }
        self.advance();
        while !self.at(lex::K_RBRACKET) && !self.at_eof() {
            out.push(self.type_expr());
            if !self.eat(lex::K_COMMA) {
                break;
            }
        }
        self.expect(lex::K_RBRACKET);
        out
    }

    fn where_clause(self) -> List[ast::WherePred] {
        let out = list::new[ast::WherePred]();
        if !self.eat(lex::K_WHERE) {
            return out;
        }
        let mut going = true;
        while going {
            let ty = self.type_expr();
            let mut bounds = list::new[ast::TraitRef]();
            if self.expect(lex::K_COLON) {
                bounds = self.trait_bounds();
            }
            out.push(ast::WherePred { ty: ty, bounds: bounds });
            if !self.eat(lex::K_COMMA) {
                going = false;
            } else {
                if self.at(lex::K_LBRACE) || self.at(lex::K_SEMI) {
                    going = false;
                }
            }
        }
        out
    }

    fn fn_decl(self, public: bool) -> ast::FnDecl {
        self.advance();
        let name = self.decl_name();
        let generics = self.generics();
        let params = list::new[ast::Param]();
        let mut self_param = Option::None;
        if self.expect(lex::K_LPAREN) {
            self_param = self.param_list(params);
        }
        let mut ret = Option::None;
        if self.eat(lex::K_ARROW) {
            ret = Option::Some(self.type_expr());
        }
        let where_preds = self.where_clause();

        if self.eat(lex::K_SEMI) {
            return ast::FnDecl {
                file: "", info: ast::UNRESOLVED, public: public, name: name, generics: generics, where_preds: where_preds,
                self_param: self_param, params: params, ret: ret, body: Option::None,
            };
        }
        let mut body = Option::None;
        if self.at(lex::K_LBRACE) {
            body = Option::Some(self.block());
        } else {
            self.error_expected("a function body `{ ... }` or `;`");
            self.sync_item();
        }
        ast::FnDecl {
            file: "", info: ast::UNRESOLVED, public: public, name: name, generics: generics, where_preds: where_preds,
            self_param: self_param, params: params, ret: ret, body: body,
        }
    }

    fn param_list(self, params: List[ast::Param]) -> Option[bool] {
        let mut self_param = Option::None;
        let mut first = true;
        while !self.at(lex::K_RPAREN) && !self.at_eof() {
            let takes_self = self.at(lex::K_SELF_VALUE)
                || (self.at(lex::K_MUT) && self.peek_is(1, lex::K_SELF_VALUE));
            if first && takes_self {
                let mutable = self.eat(lex::K_MUT);
                self.advance();
                self_param = Option::Some(mutable);
            } else {
                let mutable = self.eat(lex::K_MUT);
                let pat = self.pattern();
                let mut ty = ast::error_ty();
                if self.expect(lex::K_COLON) {
                    ty = self.type_expr();
                } else {
                    self.sync_list(lex::K_RPAREN);
                }
                params.push(ast::Param { mutable: mutable, pat: pat, ty: ty });
            }
            first = false;
            if !self.eat(lex::K_COMMA) {
                break;
            }
        }
        self.expect(lex::K_RPAREN);
        self_param
    }

    fn struct_decl(self, public: bool) -> ast::StructDecl {
        self.advance();
        let name = self.decl_name();
        let generics = self.generics();
        let where_preds = self.where_clause();
        let mut fields = list::new[ast::Field]();
        if self.expect(lex::K_LBRACE) {
            fields = self.field_list();
            self.expect(lex::K_RBRACE);
        } else {
            self.sync_item();
        }
        ast::StructDecl {
            info: ast::UNRESOLVED, public: public, name: name, generics: generics, where_preds: where_preds,
            fields: fields,
        }
    }

    fn field_list(self) -> List[ast::Field] {
        let out = list::new[ast::Field]();
        while !self.at(lex::K_RBRACE) && !self.at_eof() {
            let public = self.eat(lex::K_PUB);
            let mutable = self.eat(lex::K_MUT);
            match self.ident() {
                Option::None => {
                    self.sync_list(lex::K_RBRACE);
                    if !self.eat(lex::K_COMMA) {
                        return out;
                    }
                }
                Option::Some(name) => {
                    let mut ty = ast::error_ty();
                    if self.expect(lex::K_COLON) {
                        ty = self.type_expr();
                    } else {
                        self.sync_list(lex::K_RBRACE);
                    }
                    out.push(ast::Field { public: public, mutable: mutable, name: name, ty: ty });
                    if !self.eat(lex::K_COMMA) {
                        return out;
                    }
                }
            }
        }
        out
    }

    fn enum_decl(self, public: bool) -> ast::EnumDecl {
        self.advance();
        let name = self.decl_name();
        let generics = self.generics();
        let where_preds = self.where_clause();
        let variants = list::new[ast::Variant]();
        if !self.expect(lex::K_LBRACE) {
            self.sync_item();
            return ast::EnumDecl {
                info: ast::UNRESOLVED, public: public, name: name, generics: generics, where_preds: where_preds,
                variants: variants,
            };
        }
        while !self.at(lex::K_RBRACE) && !self.at_eof() {
            match self.ident() {
                Option::None => {
                    self.sync_list(lex::K_RBRACE);
                    if !self.eat(lex::K_COMMA) {
                        return self.finish_enum(public, name, generics, where_preds, variants);
                    }
                }
                Option::Some(vname) => {
                    let types = list::new[ast::Type]();
                    let fields = list::new[ast::Field]();
                    let mut kind = ast::VARIANT_UNIT;
                    if self.eat(lex::K_LPAREN) {
                        kind = ast::VARIANT_TUPLE;
                        while !self.at(lex::K_RPAREN) && !self.at_eof() {
                            types.push(self.type_expr());
                            if !self.eat(lex::K_COMMA) {
                                break;
                            }
                        }
                        self.expect(lex::K_RPAREN);
                    } else {
                        if self.eat(lex::K_LBRACE) {
                            kind = ast::VARIANT_STRUCT;
                            let got = self.field_list();
                            let mut i = 0;
                            while i < got.len() {
                                fields.push(got.at(i));
                                i = i + 1;
                            }
                            self.expect(lex::K_RBRACE);
                        }
                    }
                    variants.push(ast::Variant { name: vname, kind: kind, types: types, fields: fields });
                    if !self.eat(lex::K_COMMA) {
                        return self.finish_enum(public, name, generics, where_preds, variants);
                    }
                }
            }
        }
        self.finish_enum(public, name, generics, where_preds, variants)
    }

    fn finish_enum(self, public: bool, name: ast::Ident, generics: List[ast::GenericParam],
                   where_preds: List[ast::WherePred], variants: List[ast::Variant]) -> ast::EnumDecl {
        self.expect(lex::K_RBRACE);
        ast::EnumDecl {
            info: ast::UNRESOLVED, public: public, name: name, generics: generics, where_preds: where_preds,
            variants: variants,
        }
    }

    fn trait_decl(self, public: bool) -> ast::TraitDecl {
        self.advance();
        let name = self.decl_name();
        let generics = self.generics();
        let mut supertraits = list::new[ast::TraitRef]();
        if self.eat(lex::K_COLON) {
            supertraits = self.trait_bounds();
        }
        let where_preds = self.where_clause();
        let assoc = list::new[ast::AssocType]();
        let methods = list::new[ast::FnDecl]();
        if !self.expect(lex::K_LBRACE) {
            self.sync_item();
            return ast::TraitDecl {
                info: ast::UNRESOLVED, public: public, name: name, generics: generics, supertraits: supertraits,
                where_preds: where_preds, assoc: assoc, methods: methods,
            };
        }
        while !self.at(lex::K_RBRACE) && !self.at_eof() {
            let before = self.pos;
            if self.at(lex::K_TYPE) {
                self.advance();
                let aname = self.decl_name();
                let mut bounds = list::new[ast::TraitRef]();
                if self.eat(lex::K_COLON) {
                    bounds = self.trait_bounds();
                }
                self.expect(lex::K_SEMI);
                assoc.push(ast::AssocType { name: aname, bounds: bounds, ty: Option::None });
            } else {
                if self.at(lex::K_FN) {
                    methods.push(self.fn_decl(false));
                } else {
                    self.error_expected("`fn` or `type` in a trait body");
                    self.sync_stmt();
                }
            }
            if self.pos == before {
                self.advance();
            }
        }
        self.expect(lex::K_RBRACE);
        ast::TraitDecl {
            info: ast::UNRESOLVED, public: public, name: name, generics: generics, supertraits: supertraits,
            where_preds: where_preds, assoc: assoc, methods: methods,
        }
    }

    fn impl_decl(self) -> ast::ImplDecl {
        self.advance();
        let generics = self.generics();

        // `impl Trait for Type` and `impl Type` are told apart by the `for` that follows
        // the first type, so a type is parsed and reinterpreted when one appears.
        let first = self.type_expr();
        let mut trait_path = ast::PathRef { text: "", start: 0, end: 0, segs: list::new[ast::Ident](), res: ast::UNRESOLVED };
        let mut has_trait = false;
        let mut trait_args = list::new[ast::Type]();
        let mut ty = first;
        if self.eat(lex::K_FOR) {
            has_trait = true;
            trait_path = type_as_trait_path(first);
            trait_args = type_as_trait_args(first);
            ty = self.type_expr();
        }
        let where_preds = self.where_clause();

        let assoc = list::new[ast::AssocType]();
        let methods = list::new[ast::FnDecl]();
        if !self.expect(lex::K_LBRACE) {
            self.sync_item();
            return ast::ImplDecl {
                info: ast::UNRESOLVED, generics: generics, trait_path: trait_path, has_trait: has_trait,
                trait_args: trait_args, where_preds: where_preds, ty: ty, assoc: assoc,
                methods: methods,
            };
        }
        while !self.at(lex::K_RBRACE) && !self.at_eof() {
            let before = self.pos;
            let public = self.eat(lex::K_PUB);
            if self.at(lex::K_TYPE) {
                self.advance();
                let aname = self.decl_name();
                let mut aty = ast::error_ty();
                if self.expect(lex::K_ASSIGN) {
                    aty = self.type_expr();
                }
                self.expect(lex::K_SEMI);
                assoc.push(ast::AssocType {
                    name: aname, bounds: list::new[ast::TraitRef](), ty: Option::Some(aty),
                });
            } else {
                if self.at(lex::K_FN) {
                    methods.push(self.fn_decl(public));
                } else {
                    self.error_expected("`fn` or `type` in an impl body");
                    self.sync_stmt();
                }
            }
            if self.pos == before {
                self.advance();
            }
        }
        self.expect(lex::K_RBRACE);
        ast::ImplDecl {
            info: ast::UNRESOLVED, generics: generics, trait_path: trait_path, has_trait: has_trait,
            trait_args: trait_args, where_preds: where_preds, ty: ty, assoc: assoc,
            methods: methods,
        }
    }

    fn alias_decl(self, public: bool) -> ast::AliasDecl {
        self.advance();
        let name = self.decl_name();
        let generics = self.generics();
        let mut ty = ast::error_ty();
        if self.expect(lex::K_ASSIGN) {
            ty = self.type_expr();
        } else {
            self.sync_item();
        }
        self.expect(lex::K_SEMI);
        ast::AliasDecl { info: ast::UNRESOLVED, public: public, name: name, generics: generics, ty: ty }
    }

    fn const_decl(self, public: bool) -> ast::ConstDecl {
        self.advance();
        let name = self.decl_name();
        let mut ty = ast::error_ty();
        if self.expect(lex::K_COLON) {
            ty = self.type_expr();
        }
        let mut value = self.mk_expr(self.pos, ast::ExprKind::ErrorExpr);
        if self.expect(lex::K_ASSIGN) {
            value = self.expr();
        } else {
            self.sync_stmt();
        }
        self.expect(lex::K_SEMI);
        ast::ConstDecl { public: public, name: name, ty: ty, value: value }
    }
}

fn ident_span(id: ast::Ident) -> ast::Span {
    ast::Span { start: id.start, end: id.end }
}

/// A one-segment path's segment list, for the shorthand `Point { x, y }`, where the
/// field's own identifier stands in for the expression `x`.
fn one_ident(id: ast::Ident) -> List[ast::Ident] {
    let out = list::new[ast::Ident]();
    out.push(id);
    out
}

/// A parsed type reinterpreted as a trait's path, which only a path type can be.
fn type_as_trait_path(t: ast::Type) -> ast::PathRef {
    match t.node {
        ast::TypeKind::Path(path, _) => path,
        _ => ast::PathRef { text: "", start: 0, end: 0, segs: list::new[ast::Ident](), res: ast::UNRESOLVED },
    }
}

/// The same type's arguments, which are the trait's: `impl Iterator[i64] for Counter`.
fn type_as_trait_args(t: ast::Type) -> List[ast::Type] {
    match t.node {
        ast::TypeKind::Path(_, args) => args,
        _ => list::new[ast::Type](),
    }
}

// --- Types ---------------------------------------------------------------------------

impl Parser {
    fn type_expr(self) -> ast::Type {
        let start = self.pos;
        if self.at(lex::K_SELF_TYPE) {
            // Bare `Self` is the self type; `Self::Item` is a projection, so a path.
            if !self.peek_is(1, lex::K_COLONCOLON) {
                self.advance();
                return self.mk_type(start, ast::TypeKind::SelfType);
            }
            let path = self.path();
            let args = self.type_args();
            return self.mk_type(start, ast::TypeKind::Path(path, args));
        }
        if self.at(lex::K_FN) {
            self.advance();
            let params = list::new[ast::Type]();
            if self.expect(lex::K_LPAREN) {
                while !self.at(lex::K_RPAREN) && !self.at_eof() {
                    params.push(self.type_expr());
                    if !self.eat(lex::K_COMMA) {
                        break;
                    }
                }
                self.expect(lex::K_RPAREN);
            }
            let mut ret = ast::error_ty();
            if self.expect(lex::K_ARROW) {
                ret = self.type_expr();
            }
            return self.mk_type(start, ast::TypeKind::Func(params, ret));
        }
        if self.at(lex::K_LPAREN) {
            self.advance();
            if self.eat(lex::K_RPAREN) {
                return self.mk_type(start, ast::TypeKind::Unit);
            }
            let first = self.type_expr();
            if !self.at(lex::K_COMMA) {
                self.expect(lex::K_RPAREN);
                return first; // parenthesized, not a one-tuple
            }
            let elems = list::new[ast::Type]();
            elems.push(first);
            while self.eat(lex::K_COMMA) {
                if self.at(lex::K_RPAREN) {
                    break;
                }
                elems.push(self.type_expr());
            }
            self.expect(lex::K_RPAREN);
            return self.mk_type(start, ast::TypeKind::Tuple(elems));
        }
        if self.at(lex::K_IDENT) {
            let path = self.path();
            let args = self.type_args();
            return self.mk_type(start, ast::TypeKind::Path(path, args));
        }
        self.error_expected("a type");
        self.advance();
        self.mk_type(start, ast::TypeKind::ErrorType)
    }
}

// --- Statements ----------------------------------------------------------------------

fn starts_block_expr(k: i64) -> bool {
    k == lex::K_LBRACE || k == lex::K_IF || k == lex::K_MATCH || k == lex::K_WHILE
        || k == lex::K_FOR || k == lex::K_LOOP
}

fn is_block_expr(e: ast::Expr) -> bool {
    match e.node {
        ast::ExprKind::Block(_) => true,
        ast::ExprKind::If(_, _, _) => true,
        ast::ExprKind::Match(_, _) => true,
        ast::ExprKind::While(_, _) => true,
        ast::ExprKind::For(_, _, _) => true,
        ast::ExprKind::Loop(_) => true,
        _ => false,
    }
}

/// Either a statement or the block's trailing expression: exactly one is present.
struct StmtOrTail {
    stmt: Option[ast::Stmt],
    tail: Option[ast::Expr],
}

impl Parser {
    fn block(self) -> ast::Expr {
        let start = self.pos;
        let saved = self.no_struct;
        self.no_struct = false;
        let stmts = list::new[ast::Stmt]();
        let mut tail = Option::None;
        if !self.expect(lex::K_LBRACE) {
            self.no_struct = saved;
            return self.mk_expr(start,
                ast::ExprKind::Block(ast::BlockBody { stmts: stmts, tail: tail }));
        }
        let mut going = true;
        while going {
            if self.at(lex::K_RBRACE) || self.at_eof() {
                going = false;
            } else {
                let before = self.pos;
                let got = self.stmt();
                match got.tail {
                    Option::Some(t) => {
                        tail = Option::Some(t);
                        going = false;
                    }
                    Option::None => {
                        match got.stmt {
                            Option::Some(s) => { stmts.push(s); }
                            Option::None => {}
                        }
                        if self.pos == before {
                            self.advance();
                        }
                    }
                }
            }
        }
        self.expect(lex::K_RBRACE);
        self.no_struct = saved;
        self.mk_expr(start, ast::ExprKind::Block(ast::BlockBody { stmts: stmts, tail: tail }))
    }

    fn stmt(self) -> StmtOrTail {
        if self.at(lex::K_LET) {
            return StmtOrTail { stmt: Option::Some(self.let_stmt()), tail: Option::None };
        }
        if is_item_start(self.cur().kind) {
            let item = self.item();
            return StmtOrTail { stmt: Option::Some(ast::Stmt::ItemStmt(item)), tail: Option::None };
        }

        // spec/02-grammar.md: an expression whose body is braced, in statement position, is
        // a complete statement -- the parser does not carry on into a binary operator.
        if starts_block_expr(self.cur().kind) {
            let e = self.primary();
            if self.eat(lex::K_SEMI) {
                return StmtOrTail { stmt: Option::Some(ast::Stmt::ExprStmt(e, true)), tail: Option::None };
            }
            if self.at(lex::K_RBRACE) || self.at_eof() {
                return StmtOrTail { stmt: Option::None, tail: Option::Some(e) };
            }
            return StmtOrTail { stmt: Option::Some(ast::Stmt::ExprStmt(e, false)), tail: Option::None };
        }

        let e = self.expr();
        if self.eat(lex::K_SEMI) {
            return StmtOrTail { stmt: Option::Some(ast::Stmt::ExprStmt(e, true)), tail: Option::None };
        }
        if self.at(lex::K_RBRACE) || self.at_eof() {
            return StmtOrTail { stmt: Option::None, tail: Option::Some(e) };
        }
        if is_block_expr(e) {
            return StmtOrTail { stmt: Option::Some(ast::Stmt::ExprStmt(e, false)), tail: Option::None };
        }
        self.error_expected("`;` after this expression");
        self.sync_stmt();
        StmtOrTail { stmt: Option::Some(ast::Stmt::ExprStmt(e, false)), tail: Option::None }
    }

    fn let_stmt(self) -> ast::Stmt {
        let start = self.pos;
        self.advance();
        let mutable = self.eat(lex::K_MUT);
        let pat = self.pattern();
        let mut ty = Option::None;
        if self.eat(lex::K_COLON) {
            ty = Option::Some(self.type_expr());
        }
        if !self.expect(lex::K_ASSIGN) {
            self.sync_stmt();
            return ast::Stmt::Let(mutable, pat, ty,
                                  self.mk_expr(start, ast::ExprKind::ErrorExpr));
        }
        let value = self.expr();
        self.expect(lex::K_SEMI);
        ast::Stmt::Let(mutable, pat, ty, value)
    }
}

// --- Expressions, by descending precedence (spec/02-grammar.md) ----------------------

fn assign_op(k: i64) -> String {
    if k == lex::K_ASSIGN { return "="; }
    if k == lex::K_PLUSEQ { return "+="; }
    if k == lex::K_MINUSEQ { return "-="; }
    if k == lex::K_STAREQ { return "*="; }
    if k == lex::K_SLASHEQ { return "/="; }
    if k == lex::K_PERCENTEQ { return "%="; }
    ""
}

fn cmp_op(k: i64) -> String {
    if k == lex::K_EQEQ { return "=="; }
    if k == lex::K_BANGEQ { return "!="; }
    if k == lex::K_LT { return "<"; }
    if k == lex::K_LE { return "<="; }
    if k == lex::K_GT { return ">"; }
    if k == lex::K_GE { return ">="; }
    ""
}

impl Parser {
    fn expr(self) -> ast::Expr {
        self.assign_expr()
    }

    /// An expression in condition position, where a top-level struct literal would be
    /// ambiguous with the block that follows it.
    fn expr_no_struct(self) -> ast::Expr {
        let saved = self.no_struct;
        self.no_struct = true;
        let e = self.expr();
        self.no_struct = saved;
        e
    }

    fn assign_expr(self) -> ast::Expr {
        let start = self.pos;
        let lhs = self.or_expr();
        let op = assign_op(self.cur().kind);
        if op.is_empty() {
            return lhs;
        }
        self.advance();
        let rhs = self.assign_expr(); // right-associative
        self.mk_expr(start, ast::ExprKind::Assign(op, lhs, rhs))
    }

    fn or_expr(self) -> ast::Expr {
        let start = self.pos;
        let mut left = self.and_expr();
        while self.at(lex::K_OROR) {
            self.advance();
            left = self.mk_expr(start, ast::ExprKind::Binary("||", left, self.and_expr()));
        }
        left
    }

    fn and_expr(self) -> ast::Expr {
        let start = self.pos;
        let mut left = self.cmp_expr();
        while self.at(lex::K_ANDAND) {
            self.advance();
            left = self.mk_expr(start, ast::ExprKind::Binary("&&", left, self.cmp_expr()));
        }
        left
    }

    /// Comparison is non-associative: `a < b < c` is rejected rather than silently read as
    /// `(a < b) < c`.
    fn cmp_expr(self) -> ast::Expr {
        let start = self.pos;
        let left = self.bit_or_expr();
        let op = cmp_op(self.cur().kind);
        if op.is_empty() {
            return left;
        }
        let op_tok = self.advance();
        let right = self.bit_or_expr();
        let chained = cmp_op(self.cur().kind);
        if !chained.is_empty() {
            self.error_at(op_tok.start, self.cur().end, "comparison operators are non-associative");
            // Consume the rest so one mistake yields one diagnostic, not a cascade.
            self.advance();
            self.bit_or_expr();
        }
        self.mk_expr(start, ast::ExprKind::Binary(op, left, right))
    }

    fn bit_or_expr(self) -> ast::Expr {
        let start = self.pos;
        let mut left = self.bit_xor_expr();
        while self.at(lex::K_PIPE) {
            self.advance();
            left = self.mk_expr(start, ast::ExprKind::Binary("|", left, self.bit_xor_expr()));
        }
        left
    }

    fn bit_xor_expr(self) -> ast::Expr {
        let start = self.pos;
        let mut left = self.bit_and_expr();
        while self.at(lex::K_CARET) {
            self.advance();
            left = self.mk_expr(start, ast::ExprKind::Binary("^", left, self.bit_and_expr()));
        }
        left
    }

    fn bit_and_expr(self) -> ast::Expr {
        let start = self.pos;
        let mut left = self.shift_expr();
        while self.at(lex::K_AMP) {
            self.advance();
            left = self.mk_expr(start, ast::ExprKind::Binary("&", left, self.shift_expr()));
        }
        left
    }

    fn shift_expr(self) -> ast::Expr {
        let start = self.pos;
        let mut left = self.add_expr();
        let mut going = true;
        while going {
            if self.at(lex::K_SHL) {
                self.advance();
                left = self.mk_expr(start, ast::ExprKind::Binary("<<", left, self.add_expr()));
            } else {
                if self.at(lex::K_SHR) {
                    self.advance();
                    left = self.mk_expr(start, ast::ExprKind::Binary(">>", left, self.add_expr()));
                } else {
                    going = false;
                }
            }
        }
        left
    }

    fn add_expr(self) -> ast::Expr {
        let start = self.pos;
        let mut left = self.mul_expr();
        let mut going = true;
        while going {
            if self.at(lex::K_PLUS) {
                self.advance();
                left = self.mk_expr(start, ast::ExprKind::Binary("+", left, self.mul_expr()));
            } else {
                if self.at(lex::K_MINUS) {
                    self.advance();
                    left = self.mk_expr(start, ast::ExprKind::Binary("-", left, self.mul_expr()));
                } else {
                    going = false;
                }
            }
        }
        left
    }

    fn mul_expr(self) -> ast::Expr {
        let start = self.pos;
        let mut left = self.cast_expr();
        let mut going = true;
        while going {
            if self.at(lex::K_STAR) {
                self.advance();
                left = self.mk_expr(start, ast::ExprKind::Binary("*", left, self.cast_expr()));
            } else {
                if self.at(lex::K_SLASH) {
                    self.advance();
                    left = self.mk_expr(start, ast::ExprKind::Binary("/", left, self.cast_expr()));
                } else {
                    if self.at(lex::K_PERCENT) {
                        self.advance();
                        left = self.mk_expr(start, ast::ExprKind::Binary("%", left, self.cast_expr()));
                    } else {
                        going = false;
                    }
                }
            }
        }
        left
    }

    fn cast_expr(self) -> ast::Expr {
        let start = self.pos;
        let mut e = self.unary_expr();
        while self.at(lex::K_AS) {
            self.advance();
            e = self.mk_expr(start, ast::ExprKind::Cast(e, self.type_expr()));
        }
        e
    }

    fn unary_expr(self) -> ast::Expr {
        let start = self.pos;
        if self.at(lex::K_MINUS) {
            self.advance();
            return self.mk_expr(start, ast::ExprKind::Unary("-", self.unary_expr()));
        }
        if self.at(lex::K_BANG) {
            self.advance();
            return self.mk_expr(start, ast::ExprKind::Unary("!", self.unary_expr()));
        }
        self.postfix_expr()
    }

    fn postfix_expr(self) -> ast::Expr {
        let start = self.pos;
        let mut e = self.primary();
        let mut going = true;
        while going {
            if self.at(lex::K_DOT) {
                self.advance();
                match self.ident() {
                    Option::None => {
                        return self.mk_expr(start, ast::ExprKind::ErrorExpr);
                    }
                    Option::Some(name) => {
                        if self.at(lex::K_LPAREN) {
                            e = self.mk_expr(start,
                                ast::ExprKind::Method(name.name, e, self.call_args()));
                        } else {
                            e = self.mk_expr(start, ast::ExprKind::Field(name.name, e));
                        }
                    }
                }
            } else {
                if self.at(lex::K_LPAREN) {
                    e = self.mk_expr(start, ast::ExprKind::Call(e, self.call_args()));
                } else {
                    if self.at(lex::K_QUESTION) {
                        self.advance();
                        e = self.mk_expr(start, ast::ExprKind::Try(e));
                    } else {
                        going = false;
                    }
                }
            }
        }
        e
    }

    fn call_args(self) -> List[ast::Expr] {
        let saved = self.no_struct;
        self.no_struct = false;
        let out = list::new[ast::Expr]();
        self.expect(lex::K_LPAREN);
        while !self.at(lex::K_RPAREN) && !self.at_eof() {
            let before = self.pos;
            out.push(self.expr());
            if self.pos == before {
                self.sync_list(lex::K_RPAREN);
            }
            if !self.eat(lex::K_COMMA) {
                break;
            }
        }
        self.expect(lex::K_RPAREN);
        self.no_struct = saved;
        out
    }

    /// Whether the current token could begin an expression, which is how `break` and
    /// `return` tell a value from the end of the statement.
    fn can_start_expr(self) -> bool {
        let k = self.cur().kind;
        !(k == lex::K_SEMI || k == lex::K_RBRACE || k == lex::K_RPAREN
            || k == lex::K_RBRACKET || k == lex::K_COMMA || k == lex::K_EOF)
    }

    fn primary(self) -> ast::Expr {
        let start = self.pos;
        let t = self.cur();
        let k = t.kind;

        if k == lex::K_INT {
            self.advance();
            return self.mk_expr(start, ast::ExprKind::Int(t.int, t.overflow, t.suffix));
        }
        if k == lex::K_FLOAT {
            self.advance();
            return self.mk_expr(start, ast::ExprKind::Float(t.float, t.suffix));
        }
        if k == lex::K_STR {
            self.advance();
            if t.interpolated {
                return interpolated(t, self.errors, self.span_from(start));
            }
            return self.mk_expr(start, ast::ExprKind::Str(t.str));
        }
        if k == lex::K_CHAR {
            self.advance();
            return self.mk_expr(start, ast::ExprKind::Char(t.ch));
        }
        if k == lex::K_TRUE || k == lex::K_FALSE {
            self.advance();
            return self.mk_expr(start, ast::ExprKind::Bool(k == lex::K_TRUE));
        }
        if k == lex::K_SELF_VALUE {
            self.advance();
            return self.mk_expr(start, ast::ExprKind::SelfExpr);
        }
        if k == lex::K_LPAREN {
            return self.paren_or_tuple();
        }
        if k == lex::K_LBRACE {
            return self.block();
        }
        if k == lex::K_IF {
            return self.if_expr();
        }
        if k == lex::K_MATCH {
            return self.match_expr();
        }
        if k == lex::K_WHILE {
            self.advance();
            let cond = self.expr_no_struct();
            let body = self.block();
            return self.mk_expr(start, ast::ExprKind::While(cond, body));
        }
        if k == lex::K_FOR {
            self.advance();
            let pat = self.pattern();
            self.expect(lex::K_IN);
            let iter = self.expr_no_struct();
            let body = self.block();
            return self.mk_expr(start, ast::ExprKind::For(pat, iter, body));
        }
        if k == lex::K_LOOP {
            self.advance();
            let body = self.block();
            return self.mk_expr(start, ast::ExprKind::Loop(body));
        }
        if k == lex::K_BREAK {
            self.advance();
            if self.can_start_expr() {
                let v = self.expr();
                return self.mk_expr(start, ast::ExprKind::Break(Option::Some(v)));
            }
            let none: Option[ast::Expr] = Option::None;
            return self.mk_expr(start, ast::ExprKind::Break(none));
        }
        if k == lex::K_CONTINUE {
            self.advance();
            return self.mk_expr(start, ast::ExprKind::Continue);
        }
        if k == lex::K_RETURN {
            self.advance();
            if self.can_start_expr() {
                let v = self.expr();
                return self.mk_expr(start, ast::ExprKind::Return(Option::Some(v)));
            }
            let none: Option[ast::Expr] = Option::None;
            return self.mk_expr(start, ast::ExprKind::Return(none));
        }
        if k == lex::K_PIPE || k == lex::K_OROR {
            return self.lambda();
        }
        if k == lex::K_IDENT || k == lex::K_SELF_TYPE {
            return self.path_expr_or_struct_lit();
        }

        self.error_expected("an expression");
        self.advance();
        self.mk_expr(start, ast::ExprKind::ErrorExpr)
    }

    fn paren_or_tuple(self) -> ast::Expr {
        let start = self.pos;
        let saved = self.no_struct;
        self.no_struct = false;
        self.advance();
        if self.at(lex::K_RPAREN) {
            self.advance();
            self.no_struct = saved;
            return self.mk_expr(start, ast::ExprKind::Tuple(list::new[ast::Expr]()));
        }
        let first = self.expr();
        if !self.at(lex::K_COMMA) {
            self.expect(lex::K_RPAREN);
            self.no_struct = saved;
            return first; // parenthesized, not a one-tuple
        }
        let elems = list::new[ast::Expr]();
        elems.push(first);
        while self.eat(lex::K_COMMA) {
            if self.at(lex::K_RPAREN) {
                break;
            }
            elems.push(self.expr());
        }
        self.expect(lex::K_RPAREN);
        self.no_struct = saved;
        self.mk_expr(start, ast::ExprKind::Tuple(elems))
    }

    fn if_expr(self) -> ast::Expr {
        let start = self.pos;
        self.advance();
        let cond = self.expr_no_struct();
        let then = self.block();
        let mut els = Option::None;
        if self.eat(lex::K_ELSE) {
            if self.at(lex::K_IF) {
                els = Option::Some(self.if_expr());
            } else {
                els = Option::Some(self.block());
            }
        }
        self.mk_expr(start, ast::ExprKind::If(cond, then, els))
    }

    fn match_expr(self) -> ast::Expr {
        let start = self.pos;
        self.advance();
        let scrutinee = self.expr_no_struct();
        let arms = list::new[ast::Arm]();
        if !self.expect(lex::K_LBRACE) {
            return self.mk_expr(start, ast::ExprKind::Match(scrutinee, arms));
        }
        let saved = self.no_struct;
        self.no_struct = false;
        while !self.at(lex::K_RBRACE) && !self.at_eof() {
            let before = self.pos;
            let pat = self.pattern();
            let mut guard = Option::None;
            if self.eat(lex::K_IF) {
                guard = Option::Some(self.expr());
            }
            if !self.expect(lex::K_FATARROW) {
                self.sync_stmt();
                if self.pos == before {
                    self.advance();
                }
            } else {
                let body = self.expr();
                arms.push(ast::Arm { pat: pat, guard: guard, body: body });
                // A brace-bodied arm may omit its comma; any other needs one unless last.
                if !self.eat(lex::K_COMMA) && !is_block_expr(body) && !self.at(lex::K_RBRACE) {
                    self.error_expected("`,` after this match arm");
                    self.sync_stmt();
                }
                if self.pos == before {
                    self.advance();
                }
            }
        }
        self.no_struct = saved;
        self.expect(lex::K_RBRACE);
        self.mk_expr(start, ast::ExprKind::Match(scrutinee, arms))
    }

    fn lambda(self) -> ast::Expr {
        let start = self.pos;
        let saved = self.no_struct;
        self.no_struct = false;
        let params = list::new[ast::LambdaParam]();
        if self.at(lex::K_OROR) {
            self.advance(); // `||` is an empty parameter list here, not an operator
        } else {
            self.advance();
            while !self.at(lex::K_PIPE) && !self.at_eof() {
                // Not `pattern`: an or-pattern would swallow the closing `|`.
                let pat = self.pattern_no_or();
                let mut ty = Option::None;
                if self.eat(lex::K_COLON) {
                    ty = Option::Some(self.type_expr());
                }
                params.push(ast::LambdaParam { pat: pat, ty: ty });
                if !self.eat(lex::K_COMMA) {
                    break;
                }
            }
            self.expect(lex::K_PIPE);
        }
        let mut body = self.mk_expr(start, ast::ExprKind::ErrorExpr);
        let mut ret = Option::None;
        if self.eat(lex::K_ARROW) {
            ret = Option::Some(self.type_expr());
            body = self.block();
        } else {
            body = self.expr();
        }
        self.no_struct = saved;
        self.mk_expr(start, ast::ExprKind::Lambda(params, ret, body))
    }

    fn path_expr_or_struct_lit(self) -> ast::Expr {
        let start = self.pos;
        let path = self.path();
        let args = self.type_args();

        if self.at(lex::K_LBRACE) && !self.no_struct {
            return self.struct_lit(start, path, args);
        }
        // A struct literal here is what the writer meant, and exactly what §02's first
        // parser restriction forbids. `Ident :` inside the brace is a field initializer and
        // nothing else -- Origin has no labels -- so the restriction can be named rather
        // than reported as a missing semicolon several tokens later.
        if self.at(lex::K_LBRACE) && self.no_struct
            && self.peek_is(1, lex::K_IDENT) && self.peek_is(2, lex::K_COLON) {
            let t = self.cur();
            self.error_at(t.start, t.end, "a struct literal cannot appear here");
            return self.struct_lit(start, path, args);
        }
        self.mk_expr(start, ast::ExprKind::Path(path, args))
    }

    fn struct_lit(self, start: i64, path: ast::PathRef, args: List[ast::Type]) -> ast::Expr {
        let saved = self.no_struct;
        self.no_struct = false;
        self.advance();
        let fields = list::new[ast::FieldInit]();
        while !self.at(lex::K_RBRACE) && !self.at_eof() {
            match self.ident() {
                Option::None => {
                    self.sync_list(lex::K_RBRACE);
                    if !self.eat(lex::K_COMMA) {
                        break;
                    }
                }
                Option::Some(name) => {
                    let shorthand = ast::PathRef {
                        text: name.name, start: name.start, end: name.end,
                        segs: one_ident(name), res: ast::UNRESOLVED,
                    };
                    let mut value = ast::expr(ident_span(name),
                        ast::ExprKind::Path(shorthand, list::new[ast::Type]()));
                    if self.eat(lex::K_COLON) {
                        value = self.expr();
                    }
                    // Shorthand `Point { x, y }` means `x: x, y: y`.
                    fields.push(ast::FieldInit { name: name, value: value });
                    if !self.eat(lex::K_COMMA) {
                        break;
                    }
                }
            }
        }
        self.expect(lex::K_RBRACE);
        self.no_struct = saved;
        self.mk_expr(start, ast::ExprKind::StructLit(path, args, fields))
    }
}

// --- String interpolation (spec/14-strings.md) ---------------------------------------
//
// `"total: \(n + 1)"` becomes `"total: ".concat((n + 1).to_str())`, here in the parser, so
// nothing downstream learns a new form: the checker sees `concat` and `to_str` and applies
// `Str` and `Show` to them like any other call.

fn interpolated(t: lex::Token, errors: List[ParseError], at: ast::Span) -> ast::Expr {
    // Every node the desugaring builds carries the whole literal's span: none of these
    // calls is anything the programmer wrote a location for, which is what internal/parse
    // does too.
    let mut out = ast::expr(at, ast::ExprKind::ErrorExpr);
    let mut started = false;
    let mut i = 0;
    while i < t.parts.len() {
        let mut piece = ast::expr(at, ast::ExprKind::ErrorExpr);
        let mut have = false;
        match t.parts.at(i) {
            lex::Part::Text(text) => {
                // An empty chunk between two interpolations contributes nothing.
                if !text.is_empty() {
                    piece = ast::expr(at, ast::ExprKind::Str(text));
                    have = true;
                }
            }
            lex::Part::Expr(toks) => {
                piece = ast::expr(at, ast::ExprKind::Method(
                    "to_str", sub_expr(toks, errors, at), list::new[ast::Expr]()));
                have = true;
            }
        }
        if have {
            if started {
                let args = list::new[ast::Expr]();
                args.push(piece);
                out = ast::expr(at, ast::ExprKind::Method("concat", out, args));
            } else {
                out = piece;
                started = true;
            }
        }
        i = i + 1;
    }
    if !started {
        // Every part was an empty chunk, which the lexer produces only for `""` itself.
        return ast::expr(at, ast::ExprKind::Str(""));
    }
    out
}

/// One interpolation's tokens, parsed with a parser of its own.
///
/// The error list is the outer parser's, not a fresh one: a syntax error inside an
/// interpolation is the file's error and has to reach the same report, and the tokens
/// carry spans into the real source, so it already points where the programmer wrote it.
fn sub_expr(toks: List[lex::Token], errors: List[ParseError], at: ast::Span) -> ast::Expr {
    let p = Parser {
        toks: toks, pos: 0, no_struct: false, recovering: false,
        errors: errors,
    };
    let e = p.expr();
    if !p.at_eof() {
        // An interpolation holds exactly one expression (spec/01-lexical.md), so anything
        // left over is a second one rather than a chunk of the string.
        let t = p.cur();
        p.error_at(t.start, t.end, "unexpected \(lex::kind_name(t.kind)) after the interpolated expression");
    }
    e
}

// --- Patterns ------------------------------------------------------------------------

impl Parser {
    fn pattern(self) -> ast::Pat {
        let start = self.pos;
        let first = self.pattern_no_or();
        if !self.at(lex::K_PIPE) {
            return first;
        }
        let alts = list::new[ast::Pat]();
        alts.push(first);
        while self.eat(lex::K_PIPE) {
            alts.push(self.pattern_no_or());
        }
        self.mk_pat(start, ast::PatKind::Or(alts))
    }

    fn pattern_no_or(self) -> ast::Pat {
        let start = self.pos;
        let k = self.cur().kind;

        if k == lex::K_UNDERSCORE {
            self.advance();
            return self.mk_pat(start, ast::PatKind::Wild);
        }
        if k == lex::K_INT || k == lex::K_FLOAT || k == lex::K_STR || k == lex::K_CHAR
            || k == lex::K_TRUE || k == lex::K_FALSE {
            let lit = self.literal_for_pattern();
            return self.mk_pat(start, ast::PatKind::Lit(false, lit));
        }
        if k == lex::K_MINUS {
            self.advance();
            if !self.at(lex::K_INT) && !self.at(lex::K_FLOAT) {
                self.error_expected("a numeric literal after `-` in a pattern");
                self.advance();
                return self.mk_pat(start, ast::PatKind::ErrorPat);
            }
            let lit = self.literal_for_pattern();
            return self.mk_pat(start, ast::PatKind::Lit(true, lit));
        }
        if k == lex::K_LPAREN {
            return self.tuple_pattern();
        }
        if k == lex::K_MUT {
            self.advance();
            match self.ident() {
                Option::None => { return self.mk_pat(start, ast::PatKind::ErrorPat); }
                Option::Some(name) => {
                    let mut sub = Option::None;
                    if self.eat(lex::K_AT) {
                        sub = Option::Some(self.pattern_no_or());
                    }
                    return self.mk_pat(start, ast::PatKind::Bind(true, name, sub));
                }
            }
        }
        if k == lex::K_IDENT || k == lex::K_SELF_TYPE {
            let path = self.path();
            if self.at(lex::K_LPAREN) {
                return self.tuple_variant_pattern(start, path);
            }
            if self.at(lex::K_LBRACE) {
                return self.struct_pattern(start, path);
            }
            // A bare name is a binding unless it resolves to a unit variant or a constant,
            // and that decision belongs to name resolution rather than to the parser.
            if self.pos == start + 1 {
                let mut sub = Option::None;
                if self.eat(lex::K_AT) {
                    sub = Option::Some(self.pattern_no_or());
                }
                return self.mk_pat(start, ast::PatKind::Bind(false, path.segs.at(0), sub));
            }
            return self.mk_pat(start, ast::PatKind::PathUnit(path));
        }

        self.error_expected("a pattern");
        self.advance();
        self.mk_pat(start, ast::PatKind::ErrorPat)
    }

    /// Patterns admit literals and never arbitrary expressions.
    fn literal_for_pattern(self) -> ast::Expr {
        let start = self.pos;
        let t = self.advance();
        if t.kind == lex::K_INT {
            return self.mk_expr(start, ast::ExprKind::Int(t.int, t.overflow, t.suffix));
        }
        if t.kind == lex::K_FLOAT {
            return self.mk_expr(start, ast::ExprKind::Float(t.float, t.suffix));
        }
        if t.kind == lex::K_STR {
            return self.mk_expr(start, ast::ExprKind::Str(t.str));
        }
        if t.kind == lex::K_CHAR {
            return self.mk_expr(start, ast::ExprKind::Char(t.ch));
        }
        self.mk_expr(start, ast::ExprKind::Bool(t.kind == lex::K_TRUE))
    }

    fn tuple_pattern(self) -> ast::Pat {
        let start = self.pos;
        self.advance();
        if self.at(lex::K_RPAREN) {
            self.advance();
            return self.mk_pat(start, ast::PatKind::Tup(list::new[ast::Pat]()));
        }
        let first = self.pattern();
        if !self.at(lex::K_COMMA) {
            self.expect(lex::K_RPAREN);
            return first; // parenthesized, not a one-tuple
        }
        let elems = list::new[ast::Pat]();
        elems.push(first);
        while self.eat(lex::K_COMMA) {
            if self.at(lex::K_RPAREN) {
                break;
            }
            elems.push(self.pattern());
        }
        self.expect(lex::K_RPAREN);
        self.mk_pat(start, ast::PatKind::Tup(elems))
    }

    fn tuple_variant_pattern(self, start: i64, path: ast::PathRef) -> ast::Pat {
        self.advance();
        let elems = list::new[ast::Pat]();
        while !self.at(lex::K_RPAREN) && !self.at_eof() {
            let before = self.pos;
            elems.push(self.pattern());
            if self.pos == before {
                self.sync_list(lex::K_RPAREN);
            }
            if !self.eat(lex::K_COMMA) {
                break;
            }
        }
        self.expect(lex::K_RPAREN);
        self.mk_pat(start, ast::PatKind::PathTuple(path, elems))
    }

    fn struct_pattern(self, start: i64, path: ast::PathRef) -> ast::Pat {
        self.advance();
        let fields = list::new[ast::FieldPat]();
        let mut rest = false;
        while !self.at(lex::K_RBRACE) && !self.at_eof() {
            if self.at(lex::K_DOTDOT) {
                self.advance();
                rest = true;
                break;
            }
            match self.ident() {
                Option::None => {
                    self.sync_list(lex::K_RBRACE);
                    if !self.eat(lex::K_COMMA) {
                        break;
                    }
                }
                Option::Some(name) => {
                    let none: Option[ast::Pat] = Option::None;
                    let mut pat = ast::pat(ident_span(name),
                        ast::PatKind::Bind(false, name, none));
                    if self.eat(lex::K_COLON) {
                        pat = self.pattern();
                    }
                    fields.push(ast::FieldPat { name: name, pat: pat });
                    if !self.eat(lex::K_COMMA) {
                        break;
                    }
                }
            }
        }
        self.expect(lex::K_RBRACE);
        self.mk_pat(start, ast::PatKind::PathStruct(path, rest, fields))
    }
}
