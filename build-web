#!/usr/bin/env bash
# build-web — produce the playground's build output.
#
# This is what a static host runs at deploy time. It builds one artefact, `web/origin.wasm`,
# which is the only thing in `web/` that is not committed: everything else (the page, the
# editor bundle, the generated example list) is in git already, so the build's whole job is
# the module.
#
# It is deliberately not `go build` on its own, for three reasons.
#
#   1. The module's ABI and `web/wasm_exec.js` change together. `wasm_exec.js` is Go's own
#      JavaScript shim, copied verbatim, and it is committed -- so a module built by a
#      *different* Go than the one that shim came from can load and then misbehave in ways
#      that are hard to read. `tests/web` checks that pairing locally. Nothing runs tests on
#      a deploy host, so this checks it here too, and refuses rather than shipping the
#      mismatch.
#
#   2. A build host's Go version is not ours to choose, and some hosts have no Go at all
#      (Vercel's build image does not). GOTOOLCHAIN pins the exact toolchain and Go fetches
#      it on demand; if there is no Go to do the fetching, this fetches one first.
#
#   3. Everything the build writes goes inside the workspace rather than /tmp. An extracted
#      Go toolchain is ~287 MB and Go's own build temporaries go to $TMPDIR by default, so a
#      host whose /tmp is a small tmpfs gets a build killed part-way through with nothing
#      useful on stderr. The workspace is the disk the host actually gave us.
#
# Usage: ./build-web    (from anywhere; it finds the repository root itself)

set -euo pipefail

# The toolchain this page's committed wasm_exec.js came from. Changing it means copying that
# file again from the same toolchain -- the check below is what stops the two from drifting.
readonly WANT_GO=go1.24.7

cd "$(dirname "$0")"
readonly ROOT="$PWD"

say() { printf '\033[1m==>\033[0m %s\n' "$*"; }

# --- where the build is allowed to write --------------------------------------------------
#
# All inside the workspace. `outputDirectory` is `web/`, so none of this is served, and
# .gitignore keeps a local run from dirtying the tree.

export GOCACHE="$ROOT/.build/gocache"
export GOMODCACHE="$ROOT/.build/gomodcache"
export GOTMPDIR="$ROOT/.build/gotmp"
mkdir -p "$GOCACHE" "$GOMODCACHE" "$GOTMPDIR"

# --- the toolchain -----------------------------------------------------------------------

if ! command -v go >/dev/null 2>&1; then
  # Most hosts ship a Go; this is for the ones that do not. Any Go recent enough to
  # understand GOTOOLCHAIN (1.21+) would do, because the line below re-pins it anyway --
  # fetching the wanted one directly just saves a second download.
  say "no go on PATH; fetching ${WANT_GO}"
  bootstrap="$ROOT/.build/toolchain"
  mkdir -p "$bootstrap"
  curl -fsSL "https://go.dev/dl/${WANT_GO}.linux-amd64.tar.gz" | tar -xz -C "$bootstrap"
  export PATH="$bootstrap/go/bin:$PATH"
fi

# Pin the exact toolchain. Go downloads it on demand and caches it, so this is a no-op on a
# host that already has the right one.
export GOTOOLCHAIN="$WANT_GO"
say "building with $(go version)"

# What the host actually gave us, printed before the work rather than guessed at after a
# failure. A build killed for want of disk says nothing on its way out.
say "workspace: $(df -Pk "$ROOT" 2>/dev/null | awk 'NR==2{printf "%.1f GiB free", $4/1048576}' || echo 'unknown')"

# --- the shim and the module must come from the same Go ------------------------------------

shim="$(go env GOROOT)/lib/wasm/wasm_exec.js"
if [ ! -f "$shim" ]; then
  echo "error: ${WANT_GO} has no lib/wasm/wasm_exec.js at ${shim}" >&2
  exit 1
fi
if [ ! -r web/wasm_exec.js ]; then
  echo "error: web/wasm_exec.js is missing or unreadable" >&2
  exit 1
fi

# Compared with the shell itself rather than with `cmp`, which is diffutils and is not on
# every build image -- Vercel's is not. `cmp -s` then exits 127, `if ! cmp -s` reads that as
# "the files differ", and the build fails claiming a mismatch that is not there. A check that
# cannot tell "different" from "I could not look" is worse than no check, because it fails
# where it should pass and sends whoever reads it after the wrong thing.
#
# The size comparison is here because `$(cat ...)` drops trailing newlines from both sides,
# so content alone would call two files equal that differ only in how they end.
if [ "$(cat "$shim")" != "$(cat web/wasm_exec.js)" ] ||
   [ "$(wc -c < "$shim")" != "$(wc -c < web/wasm_exec.js)" ]; then
  cat >&2 <<EOF
error: web/wasm_exec.js is not the one ${WANT_GO} ships.

  committed: web/wasm_exec.js
  toolchain: ${shim}

They are two halves of one interface and are version-locked (web/README.md). Refusing to
build a module the committed shim may not load correctly. To take the toolchain's version
deliberately:

  cp ${shim} web/wasm_exec.js

and update WANT_GO in this script and the version named in web/README.md to match.
EOF
  exit 1
fi

# --- the module ----------------------------------------------------------------------------

say "compiling cmd/originwasm to WebAssembly (about 10s on two cores)"

# The exit status is reported rather than left to `set -e`, because the failure this most
# needs to be legible about -- a host killing the compiler for want of memory or disk -- does
# not come with a message of its own.
set +e
GOOS=js GOARCH=wasm go build -o web/origin.wasm ./cmd/originwasm
rc=$?
set -e
if [ "$rc" -ne 0 ]; then
  echo "error: the compiler exited with status ${rc}" >&2
  if [ "$rc" -ge 128 ]; then
    echo "  (a status of 128 or more means it was killed by a signal $((rc - 128)) rather" >&2
    echo "   than failing on its own; on a build host that is usually memory or disk)" >&2
  fi
  df -Pk "$ROOT" >&2 2>/dev/null || true
  exit "$rc"
fi

if [ ! -s web/origin.wasm ]; then
  echo "error: web/origin.wasm was not produced" >&2
  exit 1
fi

say "web/origin.wasm is $(wc -c < web/origin.wasm) bytes"
say "build output is web/"
